<project name="install" default="install">
	<property file="${install.package.path}/ci.properties" />

	<target name="clean-install" depends="">
		<echo message="Begin to clean install env..." />
		<delete dir="${install.package.path}/sequoiadb" />
		<echo message="Clean install env compeleted." />
	</target>

	<target name="install" depends="clean-install">
		<echo message="Begin to install..." />

		<untar src="${install.package.path}/${install.package.name}" dest="${install.package.path}" compression="gzip"/>
		<property name="db.path" value="${install.package.path}/sequoiadb" />

		<mkdir dir="${db.path}/database/cata" />
		<mkdir dir="${db.path}/database/data" />
		<mkdir dir="${db.path}/database/log/cata" />
		<mkdir dir="${db.path}/database/log/data" />
		<mkdir dir="${db.path}/database/log/coord" />
		<mkdir dir="${db.path}/database/conf/local/sdb.cata.conf" />
		<mkdir dir="${db.path}/database/conf/local/sdb.data.conf" />
		<mkdir dir="${db.path}/database/conf/local/sdb.coord.conf" />

		<copy file="${db.path}/conf/samples/sdb.cat" tofile="${db.path}/conf/local/sdb.cata.conf/sdb.cat" />
		<copy file="${db.path}/conf/samples/sdb.conf.catalog" tofile="${db.path}/conf/local/sdb.cata.conf/sdb.conf" />
		<copy file="${db.path}/conf/samples/sdb.conf.data" tofile="${db.path}/conf/local/sdb.data.conf/sdb.conf" />
		<copy file="${db.path}/conf/samples/sdb.conf.coord" tofile="${db.path}/conf/local/sdb.coord.conf/sdb.conf" />
		
		<chmod file="${db.path}/bin/sequoiadb" perm="u+x"/>

		<exec dir="${db.path}/bin" executable="${db.path}/bin/sequoiadb" spawn="true">
			<arg line="-c $${db.path}/conf/local/sdb.cata.conf" />
			<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${db.path}/bin" />
		</exec>

		<exec dir="${db.path}/bin" executable="${db.path}/bin/sequoiadb" spawn="true">
			<arg line="-c $${db.path}/conf/local/sdb.data.conf" />
			<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${db.path}/bin" />
		</exec>

		<exec dir="${db.path}/bin" executable="${db.path}/bin/sequoiadb" spawn="true">
			<arg line="-c $${db.path}/conf/local/sdb.coord.conf" />
			<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${db.path}/bin" />
		</exec>

		<echo message="Install compeleted." />
	</target>
</project>