<project name="build-all" default="build-all">
	<property name="ci.script.path" value="${WORKSPACE}/sequoiadb/misc/ci" />
	<property file="${ci.script.path}/ci.properties" />

	<property name="deploy.path" value="${WORKSPACE}/deploy" />
	<property name="release.dirname" value="/release" />
	<property name="build.testcases" value="${WORKSPACE}/sequoiadb/testcases/hlt/" />

	<target name="clean" depends="">
		<echo message="Begin to clean environments" />
		<delete dir="${deploy.path}/" />
		<delete file="${WORKSPACE}/${deploy.tar.file.name}" />
		<delete dir="${WORKSPACE}/${release.dirname}" />
		<delete dir="${build.testcases}/build" />
		<echo message="clean environments completed." />
	</target>

	<target name="build-src-test" depends="clean">
		<mkdir dir="${deploy.path}" />

		<echo message="Begin to compile source code..." />
		<ant antfile="${WORKSPACE}/sequoiadb/misc/ci/build-sourcecode.xml" target="mk-release">
			<property name="WORKSPACE" value="${WORKSPACE}" />
			<property name="install.packege.name" value="${install.tar.file.name}" />
			<property name="deploy.path" value="${deploy.path}" />
			<property name="release.dirname" value="${release.dirname}" />
			<property name="compile.debug" value="${compile.debug}" />
		</ant>
		<echo message="Compile source code completed." />

		<echo message="Begin to compile js test code..." />
		<ant antfile="${WORKSPACE}/sequoiadb/testcases/hlt/junit_testcases/src/build.xml" target="compile-test">
			<property name="build.testcases" value="${build.testcases}/junit_testcases" />
			<property name="deploy.path" value="${deploy.path}" />
		</ant>
		<echo message="Compile source test completed." />

		<echo message="Begin to compile ant test code..." />
		<ant antfile="${WORKSPACE}/sequoiadb/misc/ci/build-ant-testcase.xml" target="dist-ant-testcase">
			<property name="build.testcases" value="${build.testcases}/ant_testcases" />
			<property name="deploy.path" value="${deploy.path}" />
		</ant>
		<echo message="Compile ant test completed." />
	</target>

	<target name="build-ant-tasks" depends="build-src-test">
		<mkdir dir="${ci.script.path}/ant-sdbtask/build" />

		<javac srcdir="${ci.script.path}/ant-sdbtask/src" destdir="${ci.script.path}/ant-sdbtask/build" fork="yes" executable="${WORKSPACE}/sequoiadb/java/jdk_linux64/bin/javac">
			<classpath>
				<pathelement location="${WORKSPACE}/sequoiadb/driver/java/sequoiadb.jar" />
			</classpath>
		</javac>

		<jar destfile="${ci.script.path}/ant-sdbtask/">
			<fileset dir="${ci.script.path}/ant-sdbtask/build" />
		</jar>
	</target>

	<target name="build-all" depends="build-src-test, build-ant-tasks">
		<copy file="${ci.script.path}/ci.properties" todir="${deploy.path}" />
		<copy file="${ci.script.path}/install-basic-in-host.xml" todir="${deploy.path}" />
		<copy file="${ci.script.path}/exec-basic-testcases.xml" todir="${deploy.path}" />
		<mkdir dir="${deploy.path}/ant-tasks" />
		<copy file="${ci.script.path}/ant-sdbtask/ant-sdbtasks.jar" todir="${deploy.path}/ant-tasks" />
		<tar destfile="${WORKSPACE}/${deploy.tar.file.name}" basedir="${WORKSPACE}" includes="deploy/**" compression="gzip" />
	</target>

</project>