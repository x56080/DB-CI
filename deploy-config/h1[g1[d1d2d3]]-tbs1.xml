<!--@param ${STAF.PATH}: The path where is staf binary directory-->
<!--@param ${ant.sdb.tasks.path}:  The path where sdb's ant tasks jar files -->
<!--@param ${install.path}: The path where install sequoiadb -->
<!--@param ${deploy.file.fullname}: The file full path where deploy file name for test -->
<!--@param ${deploy.path}: The path where deploy direcotry before tar -->
<!--@param ${test.machine.no1}: The host name or host ip of test machine No.1 -->
<!--@param ${test.machine.no2}: The host name or host ip of test machine No.1 -->
<!--@param ${test.machine.no2}: The host name or host ip of test machine No.1 -->
<!--@param ${test.machine.no3}: The host name or host ip of test machine No.1 -->

<project name="deploy" default="test">
	<property file="ci.properties" />
	<taskdef resource="com/sequoiadb/ant/ant-sdbtasks.xml">
		<classpath>
			<fileset dir="${deploy.path}/ant-sdbtasks/" includes="*.jar" />
			<pathelement location="${STAF.PATH}/lib/JSTAF.jar" />
			<pathelement location="${STAF.PATH}/samples/demo/STAFDemo.jar" />
		</classpath>
	</taskdef>

	<target name="clean" depends="">
		<echo message="Begin to clean test env..." />

		<parallel>
			<ant antfile="deploy-basic-in-host.xml" dir="." target="clean-deploy-basic-in-host" inheritAll="false">
				<property name="deploy.file.fullname" value="${deploy.file.fullname}" />
				<property name="deploy.host.name" value="${test.machine.no1}" />
			</ant>
			<ant antfile="deploy-basic-in-host.xml" dir="." target="clean-deploy-basic-in-host" inheritAll="false">
				<property name="deploy.file.fullname" value="${deploy.file.fullname}" />
				<property name="deploy.host.name" value="${test.machine.no2}" />
			</ant>
			<ant antfile="deploy-basic-in-host.xml" dir="." target="clean-deploy-basic-in-host" inheritAll="false">
				<property name="deploy.file.fullname" value="${deploy.file.fullname}" />
				<property name="deploy.host.name" value="${test.machine.no3}" />
			</ant>
		</parallel>

	</target>

	<target name="deploy" depends="clean">
		<echo message="Begin install software and test files to ${test.machine1}" />
		<hostinfo prefix="host" />

		<parallel>
			<ant antfile="deploy-basic-in-host.xml" dir="." inheritAll="false">
				<property name="deploy.file.fullname" value="${deploy.file.fullname}" />
				<property name="deploy.host.name" value="${test.machine.no1}" />
			</ant>
			<ant antfile="deploy-basic-in-host.xml" dir="." inheritAll="false">
				<property name="deploy.file.fullname" value="${deploy.file.fullname}" />
				<property name="deploy.host.name" value="${test.machine.no2}" />
			</ant>
			<ant antfile="deploy-basic-in-host.xml" dir="." inheritAll="false">
				<property name="deploy.file.fullname" value="${deploy.file.fullname}" />
				<property name="deploy.host.name" value="${test.machine.no3}" />
			</ant>
		</parallel>

		<sdbdeploy host="${test.machine.no1}" coordport="50000">
			<catagroup name="cata1">
				<node host="${test.machine.no1}" baseport="30000" dbpath="${install.path}/sequoiadb/database/cata/30000">
					<configitem name="loglevel" value="5" />
				</node>
				<node host="${test.machine.no2}" baseport="30000" dbpath="${install.path}/sequoiadb/database/cata/30000">
					<configitem name="loglevel" value="5" />
				</node>
			</catagroup>
		</sdbdeploy>

		<sdbdeploy host="${test.machine.no1}" coordport="50000">
			<datagroup name="group1">
				<node host="${test.machine.no1}" baseport="51000" dbpath="${install.path}/sequoiadb/database/data/51000">
					<confitem name="loglevel" value="5" />
				</node>
				<node host="${test.machine.no2}" baseport="51000" dbpath="${install.path}/sequoiadb/database/data/51000">
					<confitem name="loglevel" value="5" />
				</node>
				<node host="${test.machine.no3}" baseport="51000" dbpath="${install.path}/sequoiadb/database/data/51000">
					<confitem name="loglevel" value="5" />
				</node>
			</datagroup>
		</sdbdeploy>
	</target>

	<target name="test" depends="deploy">
		<sdbtest host="${test.machine.no1}" testscript="${test.machine.deploy.path}/deploy/exec-basic-testcases_new.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/js_testcases/reports" masterreports="${test.reports.path}" timeout="30m">
			<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/js_testcases/" />
			<param name="install.path" value="${install.path}" />
		</sdbtest>
	</target>

</project>