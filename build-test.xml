<!--@param ${WORKSPACE}: the path where for this job-->
<!--@param ${os.publish.name}: os name for example suse/ubuntu/redhat-->
<!--@param ${ci.script.path} : The path where place ci script files-->

<project name="build-test" default="build-test">
	<property name="deploy.path" value="${WORKSPACE}/deploy" />
	<property name="release.path" value="${WORKSPACE}/release" />
	<property name="build.testcases" value="${WORKSPACE}/sequoiadb/testcases/hlt/" />
	<property name="DRIVER.DIR" value="${WORKSPACE}/release/driver" />

	<target name="clean" depends="">
		<echo message="Begin to clean environments" />
		<property file="${ci.script.path}/ci.test.properties" />

		<delete dir="${deploy.path}/" />
		<delete file="${WORKSPACE}/${deploy.tar.file.name}" />

		<delete dir="${build.testcases}/build" />
		<echo message="clean environments completed." />
	</target>

	<target name="compile-test" depends="clean">
		<mkdir dir="${deploy.path}" />

		<echo message="Begin to build the driver test code..." />
		<ant antfile="${ci.script.path}/build-driver-test.xml" target="build-driver-test">
			<property name="build.testcases" value="${WORKSPACE}/sequoiadb/testcases/hlt/drivers_testcases/" />
			<property name="WORKSPACE" value="${WORKSPACE}" />
			<property name="lib.dir" value="${WORKSPACE}/release/driver" />
		</ant>
		<echo message="Compile  builded the driver test. " />

	</target>

	<target name="build-ant-tasks" depends="compile-test">
		<ant antfile="${ci.script.path}/ant-sdbtask/build.xml">
			<property name="java.driver.jar" value="${WORKSPACE}/release/driver/java/sdbdriver.jar" />
			<property name="javac.base.dir" value="${WORKSPACE}/sequoiadb" />
			<property name="root.dir" value="${WORKSPACE}/sequoiadb/misc/ci/ant-sdbtask" />
		</ant>  
	</target>

	<target name="build-test" depends="compile-test, build-ant-tasks">

		<mkdir dir="${deploy.path}/hlt/js_testcases/" />

		<copy todir="${deploy.path}/hlt/js_testcases/">
			<fileset dir="${build.testcases}/js_testcases/" />
		</copy>

		<mkdir dir="${deploy.path}/hlt/ant_testcases/" />
		<copy todir="${deploy.path}/hlt/ant_testcases/">
			<fileset dir="${build.testcases}/ant_testcases/" />
		</copy>

		<copy file="${ci.script.path}/ci.test.properties" todir="${deploy.path}" />
		<copy file="${ci.script.path}/exec-basic-testcases.xml" todir="${deploy.path}" />
		<copy file="${ci.script.path}/exec-ant-testcases.xml" todir="${deploy.path}" />
		<copy file="${ci.script.path}/exec-driver-java-test.xml" todir="${deploy.path}" />
		<copy file="${ci.script.path}/exec-driver-C-test.xml" todir="${deploy.path}" />
		
		<mkdir dir="${deploy.path}/ant-sdbtasks" />
		<copy file="${ci.script.path}/ant-sdbtask/ant-sdbtasks.jar" todir="${deploy.path}/ant-sdbtasks" />
		<!--copy file="${ci.script.path}/ant-sdbtask/lib/JSTAF.jar" todir="${deploy.path}/ant-sdbtasks" /-->
		<copy file="${WORKSPACE}/release/driver/java/sdbdriver.jar" todir="${deploy.path}/ant-sdbtasks" />
		<tar destfile="${WORKSPACE}/${deploy.tar.file.name}" basedir="${WORKSPACE}" includes="deploy/**" compression="gzip" />
	</target>

</project>