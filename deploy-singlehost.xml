<project name="deploy" default="deploy">
	<property file="${WORKSPACE}/sequoiadb/misc/ci/ci.properties" />
	<property name="test.machine.deploy.path" value="${test.machine.deploy.parent.path}/${test.machine.deploy.dir}"/>

		<target name="clean-deploy" depends="">
			<echo message="Begin to clean deploy env..."/>
			<exec executable="staf" dir="${STAF_PATH}" failonerror="true" failifexecutionfails="true">
				<arg line="${test.machine.deploy.ip1} FS DELETE ENTRY test.machine.deploy.path  CONFIRM" />
				<env key="PATH" path="${env.PAHT}:${STAF.PATH}/bin" />
				<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
				<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
			</exec>

			<exec executable="staf" dir="${STAF_PATH}" failonerror="true" failifexecutionfails="true">
				<arg line="${test.machine.deploy.ip1} FS CREATE DIRECTORY ${test.machine.deploy.dir} ${test.machine.deploy.parent.path}" />
				<env key="PATH" path="${env.PAHT}:${STAF.PATH}/bin" />
				<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
				<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
			</exec>
			<echo message="Clean deploy env compeleted."/>
		</target>

		<target name="deploy" depends="clean-deploy">
			<echo message="Begin to deploy softeware and test..."/>
			<exec executable="staf" dir="${STAF_PATH}" failonerror="true" failifexecutionfails="true">
				<arg line="LOCAL FS COPY FILE ${WORKSPACE}/${deploy.tar.file.name} TODIRECTORY ${test.machine.deploy.path} TOMACHINE ${test.machine.deploy.ip1}" />
				<env key="PATH" path="${env.PAHT}:${STAF.PATH}/bin" />
				<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
				<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
			</exec>

			<exec executable="staf" dir="${STAF_PATH}" failonerror="true" failifexecutionfails="true">
				<arg line="LOCAL FS COPY FILE ${WORKSPACE}/sequoiadb/misc/ci/test-all.xml TODIRECTORY ${test.machine.deploy.path} TOMACHINE ${test.machine.deploy.ip1}" />
				<env key="PATH" path="${env.PAHT}:${STAF.PATH}/bin" />
				<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
				<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
			</exec>
			
			<exec executable="staf" dir="${STAF_PATH}" failonerror="true" failifexecutionfails="true">
				<arg line="${test.machine.deploy.ip1} PROCESS START COMMAND  ant -f ${test.machine.deploy.path}/test-all.xml -Dtest.basedir=${test.machine.deploy.path} -Ddeploy.filename=deploy.tar.file.name WORKDIR ${test.machine.deploy.path} WAIT 30m" />
				<env key="PATH" path="${env.PAHT}:${STAF.PATH}/bin" />
				<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
				<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
			</exec>

			<echo message="Deploy softeware and test compeleted."/>
		</target>
	</project>



