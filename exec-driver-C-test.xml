<!--@param ${testcase.path}: The path where test case direcotry.-->
<!--@param ${reports.path}: The path where test case direcotry.-->
<!--@param ${lib.dir}: The path where libsdbc.so is. -->
<!--@param ${test_name}: will not test name. -->

<project name="exec-driver-C-test" default="exec-driver-C-test">

    <property name="test_name" value="*" />               
		<property name="c_test.dir" value="${testcase.path}/C/build" />
		
    <property name="append" value=" --gtest_filter=${test_name}  --gtest_output=xml:${reports.path} " />
    
<target name="clean-env" depends="">
	 <delete dir="${reports.path}" failonerror="false" />
	 <mkdir dir="${reports.path}" />
	 <!--unjar src="${WORKSPACE}/deploy/hlt/drivers_testcases/lib/java_test.jar" dest="${java_test.dir}" /-->

</target>

<target name="exec-driver-C-test" depends="clean-env">
   
   <echo message="..... begin to test the C driver test ...." />
   
   <echo message="exec chmod u+x * .... path is  ${testcase.path}/C/build " />
   <exec executable="chmod u+x * " dir="${testcase.path}/C/build" />
   
   
   <echo message="exec ./collectionspace  ${append} ...path is ${testcase.path}/C/build ..." />
   <echo message="env is LD_LIBRARY_PATH=${lib.dir}" />
   <exec executable="./collectionspace" dir="${testcase.path}/C/build" >
      <arg line=" ${append} " />
      <env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${lib.dir}" />
   </exec>
   
   <echo message="...test driver C is over , report file is in ${reports.path} ..." />
   
</target>
</project>
