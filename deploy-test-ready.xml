
<!--@param ${deploy.host.name} :  The host name for deploy test scripts and install software-->
<!--@param ${test.machine.deploy.path}:  The path where deploy install package and test scripts-->
<!--@param ${coord.service.port}:  coord's service port-->
<!--@param ${is.standalone.mode}:  the flag whether start with standalone mode-->

<project name="copy_tar_deploy" default="copy_tar_deploy">
	
	
	
	<target name="clean" depends="">
		<echo message="copy ci files to sequoiadb/misc/ci " />
		<delete file="${WORKSPACE}/sequoiadb" />
		<mkdir dir="${WORKSPACE}/sequoiadb/misc/ci" />
		
		
		<delete file="${WORKSPACE}/${deploy.tar.file.name}" />
		<copy file="${WORKSPACE}/ci/ci.properties.${os.publish.name}" tofile="${WORKSPACE}/sequoiadb/misc/ci/ci.properties" />
		
		
		<copy todir="${WORKSPACE}/sequoiadb/misc/ci">
			<fileset dir="${WORKSPACE}/ci" includes="**/**" />
		</copy>
		
		<property file="ci.properties" />
	<property name="is.standalone.mode" value="false"/>
		
	</target>
	
	<target name="copy_tar_deploy" depends="clean">
		
		<property environment="env" />

		<echo message="Begin to copy the deploy.tar.gz with STAF.PATH=${STAF.PATH},env.PATH=${env.PATH},deploy.host.name=${deploy.host.name}" />

    <echo message="${STAF.PATH}\bin\staf  ${target.deploy_tar_gz.ip} FS GET  FILE ${test_tar}/${deploy.tar.file.name}" />
		<exec command="${STAF.PATH}\bin\staf ${target.deploy_tar_gz.ip} FS GET  FILE ${test_tar}/${deploy.tar.file.name} BINARY" dir="${STAF.PATH}" failonerror="true" failifexecutionfails="true">
			<env key="PATH" path="${env.PATH}:${STAF.PATH}/bin" />
			<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
			<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
		</exec>
		
		<echo message="ready is ok " />
	</target>


</project>



