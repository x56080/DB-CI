
<!--@param ${WORKSPACE} :  The workspace path-->
<!--@param ${os.publish.name} : the os name, for example: suse , ubuntu, etc-->
<!--@param ${ci.script.path} : The path where place ci script files-->

<project name="copy_tar_deploy" default="copy_tar_deploy">
	<property environment="env" />
	<property name="release.path" value="${WORKSPACE}/release" />

	<target name="clean" depends="">
		<echo message="delete ${release.path}" />
		<delete dir="${release.path}" />
	</target>

	<target name="copy_tar_deploy" depends="clean">
		<copy file="${ci.script.path}/ci.test.properties.${os.publish.name}" tofile="${ci.script.path}/ci.test.properties" />
		<property file="${ci.script.path}/ci.test.properties" />
		
		<mkdir dir="${release.path}" />

		<echo message="Begin to copy the software package with STAF.PATH=${STAF.PATH},env.PATH=${env.PATH},deploy.host.name=${deploy.host.name}" />
		<hostinfo prefix="local" />
		<echo message="${STAF.PATH}\bin\staf ${target.deploy_tar_gz.ip} FS COPY FILE ${copy_tar}/build.version TODIRECTORY ${release.path} TOMACHINE ${local.ADDR4}" />
		<exec command="${STAF.PATH}\bin\staf ${target.deploy_tar_gz.ip} FS COPY FILE ${copy_tar}/build.version TODIRECTORY ${release.path} TOMACHINE ${local.ADDR4}" dir="${STAF.PATH}" failonerror="true" failifexecutionfails="true">
			<env key="PATH" path="${env.PATH}:${STAF.PATH}/bin" />
			<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
			<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
		</exec>

		<property file="${WORKSPACE}/build.version" />

		<echo message="${STAF.PATH}\bin\staf ${target.deploy_tar_gz.ip} FS COPY FILE ${copy_tar}/${BUILD.FILENAME}.${BUILD.NUMBER} TODIRECTORY ${release.path} TOMACHINE ${local.ADDR4}" />
		<exec command="${STAF.PATH}\bin\staf ${target.deploy_tar_gz.ip} FS COPY FILE ${copy_tar}/${BUILD.FILENAME}.${BUILD.NUMBER} TODIRECTORY ${release.path} TOMACHINE ${local.ADDR4}" dir="${STAF.PATH}" failonerror="true" failifexecutionfails="true">
			<env key="PATH" path="${env.PATH}:${STAF.PATH}/bin" />
			<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
			<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
		</exec>

		<move file="${WORKSPACE}/${BUILD.FILENAME}.${BUILD.NUMBER}" tofile="${WORKSPACE}/${BUILD.FILENAME}" />

	</target>


</project>



