
<!--@param ${deploy.host.name} :  The host name for deploy test scripts and install software-->
<!--@param ${test.machine.deploy.path}:  The path where deploy install package and test scripts-->
<!--@param ${coord.service.port}:  coord's service port-->
<!--@param ${is.standalone.mode}:  the flag whether start with standalone mode-->

<project name="copy_tar_deploy" default="copy_tar_deploy">
	<property file="ci.properties" />
	<property name="is.standalone.mode" value="false"/>
	
	
	<target name="clean" depends="">
		<echo message="copy ci files to sequoiadb/misc/ci " />
		<delete file="${WORKSPACE}/sequoiadb" />
		<mkdir dir="${WORKSPACE}/sequoiadb/misc/ci" />
		<copy todir="${WORKSPACE}/sequoiadb/misc/ci">
			<fileset dir="${WORKSPACE}/ci" includes="**/**" />
		</copy>
		
	</target>
	
	<target name="copy_tar_deploy" depends="clean">
		<echo message="ready is ok " />
	</target>


</project>



