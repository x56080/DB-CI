<project name="build-all" default="main">
	<target name="main" depends="">
		<echo message="Begin to compile source code..." />
		<ant antfile="${WORKSPACE}/sequoiadb/misc/ci/build-sourcecode.xml" target="compile">
			<property name="WORKSPACE" value="${WORKSPACE}" />
			<property name="TAR_FILE_NAME" value="${TAR_FILE_NAME}" />
		</ant>
		<echo message="Compile source code completed." />

		<echo message="Begin to compile test code..." />
		<ant antfile="${WORKSPACE}/testcases/hlt/junit_testcases/build.xml" target="compile">
			<property name="build.testcases" value="${WORKSPACE}/sequoiadb/testcases/hlt/junit_testcases" />
		</ant>
		<echo message="Compile source test completed." />
	</target>

</project>