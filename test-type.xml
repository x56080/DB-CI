<!--@param ${test.machine.deploy.path} , where test cases in the test machine-->
<!--@param ${test.machine.deploy.path} , where deploy file in the test machine-->
<!--@param ${install.path} , the sequoiadb install path -->
<!--@param ${test.reports.path} , where the report put in-->
<!--@param ${test.machine.no1.basic} , test machine's port -->
<!--@param ${test.machine.no2.basic} , test machine's port -->
<!--@param ${test.machine.no3.basic} , test machine's port -->
<!--@param ${test.machine.no4.basic} , test machine's port -->
<!--@param ${test.machine.no1.unnormal} , test machine's port -->
<!--@param ${test.machine.no2.unnormal} , test machine's port -->
<!--@param ${test.machine.no3.unnormal} , test machine's port -->
<!--@param ${test.machine.no4.unnormal} , test machine's port -->
<!--@param ${test-type} , what the test type-->
<project name="test-type" default="test-type">

   <target name="test-type" depends="">
      <property environment="env" />
      <switch value="${test-type}">
         <case value="basic">
         	
	          <echo message="begin to test js tests ..." />
						<sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-basic-testcases.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/js_testcases/reports" masterreports="${test.reports.path}" timeout="30m">
							<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/js_testcases/" />
							<param name="install.path" value="${install.path}" />
							<param name="excludes.dir.patterns" value="vote" />
							<param name="antTask.jar.path" value="${test.machine.deploy.path}/deploy/ant-sdbtasks" />
						</sdbtest>
				    <echo message="...test js tests are over ..." />
				    
         </case>
         <case value="ant">
         	
				    <echo message="... test ant-testcases ..." />
						<sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-ant-testcases.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/ant_testcases/reports" masterreports="${test.reports.path}" timeout="30m">
							<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/ant_testcases/" />
							<param name="install.path" value="${install.path}" />
						</sdbtest>
						<echo message="... test ant-testcases is over ..." />
						
         </case>
         <case value="driver-java">
         
				    <echo message="... test the java driver ..." />                                                                                   
						<sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-driver-java-test.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/drivers_testcases/java/reports" masterreports="${test.reports.path}" timeout="30m">
							<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/drivers_testcases" />
							<param name="install.path" value="${install.path}" />
							<param name="deploy.case.fullname" value="${deploy.case.fullname}" />
						</sdbtest>
						<echo message="... test java driver is over ..." />
						
         </case>
         <case value="driver-C">
         
				    <echo message="... test the C driver ..." />
				    <property name="testCcases" value="*-*sdbConnect_with_usr*:*sdbCreateCollection1_doubtful*:*sdbCreateUsr*:*sdbListReplicaGroups*:*sdbRemoveUsr*:*sdbResetSnapshot*:*sdbSplitCollection*" />     
						<sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-driver-C-test.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/drivers_testcases/C/reports" masterreports="${test.reports.path}" timeout="30m">
							<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/drivers_testcases" />
							<param name="test_name" value="${testCcases}"  />
							<param name="deploy.case.fullname" value="${deploy.case.fullname}" />
						</sdbtest>
						<echo message="... test C driver is over ..." />
						
         </case>
         <case value="driver-CPP">
         
				    <echo message="... test the CPP driver ..." />		
						<property name="testCPPcases" value="*-*create*:*drop*:*insert_with_iterator*:*rename*:*split*:*createCollection_with_Sharding_and_replSize*:*resetSnapshot*:*transactionBegin*:*transactionCommit*:*transactionRollback*:*getList_SDB_LIST_GROUPS*" />
						<sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-driver-CPP-test.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/drivers_testcases/CPP/reports" masterreports="${test.reports.path}" timeout="30m">
							<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/drivers_testcases" />
							<param name="test_name" value="${testCPPcases}"  />
							<param name="deploy.case.fullname" value="${deploy.case.fullname}" />
						</sdbtest>
				    <echo message="... test CPP driver is over ..." />
				    
         </case>
         <case value="sample">
				         
				    <echo message="... test the client sample test ..." />
						<sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-samples-testcases.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/samples_testcases/CPP/reports" masterreports="${test.reports.path}" timeout="30m">
							<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/samples_testcases" />
							<param name="deploy.case.fullname" value="${deploy.case.fullname}" />
						</sdbtest>
				    <echo message="... client sample test is over ..." />
    
         </case>
         <case value="tpcc">
            <echo message=" ...begin to test tpcc ..." />
	          <sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-tpcc-testcases.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/tpcc_testcases/reports" masterreports="${test.reports.path}" timeout="60m">
				     	<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/sql_testcases/" />
							<param name="install.path" value="${install.path}" />
							<param name="deploy.case.fullname" value="${deploy.case.fullname}" />
							<param name="antTask.jar.path" value="${test.machine.deploy.path}/deploy/ant-sdbtasks" />
						</sdbtest>
				    <echo message=" ... tpcc test over ..." />
				    
         </case>
         
         <case value="basic-tpcc">
	         <parallel failonany="true" >
				    	
					    <echo message=" ...begin to test tpcc ..." />
					    <sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-tpcc-testcases.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/tpcc_testcases/reports" masterreports="${test.reports.path}" timeout="30m">
								<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/sql_testcases/" />
								<param name="install.path" value="${install.path}" />
								<param name="deploy.case.fullname" value="${deploy.case.fullname}" />
								<param name="antTask.jar.path" value="${test.machine.deploy.path}/deploy/ant-sdbtasks" />
							</sdbtest>
					    <echo message=" ... tpcc test over ..." />	
				    	
					    <echo message="begin to test js tests ..." />
							<sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-basic-testcases.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/js_testcases/reports" masterreports="${test.reports.path}" timeout="30m">
								<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/js_testcases/" />
								<param name="install.path" value="${install.path}" />
								<param name="excludes.dir.patterns" value="vote" />
								<param name="antTask.jar.path" value="${test.machine.deploy.path}/deploy/ant-sdbtasks" />
							</sdbtest>
					    <echo message="...test js tests are over ..." />	
	    	
	    		 </parallel>
         </case>
         <default>
            <parallel failonany="true" >
				    	
					    <echo message=" ...begin to test tpcc ..." />
					    <sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-tpcc-testcases.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/tpcc_testcases/reports" masterreports="${test.reports.path}" timeout="30m">
								<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/sql_testcases/" />
								<param name="install.path" value="${install.path}" />
								<param name="deploy.case.fullname" value="${deploy.case.fullname}" />
								<param name="antTask.jar.path" value="${test.machine.deploy.path}/deploy/ant-sdbtasks" />
							</sdbtest>
					    <echo message=" ... tpcc test over ..." />	
				    	
					    <echo message="begin to test js tests ..." />
							<sdbtest host="${test.machine.no2.basic}" testscript="${test.machine.deploy.path}/deploy/exec-basic-testcases.xml" remotereports="${test.machine.deploy.path}/deploy/hlt/js_testcases/reports" masterreports="${test.reports.path}" timeout="30m">
								<param name="testcase.path" value="${test.machine.deploy.path}/deploy/hlt/js_testcases/" />
								<param name="install.path" value="${install.path}" />
								<param name="excludes.dir.patterns" value="vote" />
								<param name="antTask.jar.path" value="${test.machine.deploy.path}/deploy/ant-sdbtasks" />
							</sdbtest>
					    <echo message="...test js tests are over ..." />	
	    	
	    		 </parallel>
         </default>
      </switch>
   </target>


</project>