<project name="test-exception-testcases" default="test-exception-testcases">
	<taskdef resource="net/sf/antcontrib/antlib.xml">
		<classpath>
			<pathelement location="C:\Tools\ant-contrib-1.0b3-bin\ant-contrib\ant-contrib-1.0b3.jar" />
		</classpath>
	</taskdef>

	<target name="clean-test-reports" depends="">
		<echo message="Begin to clean test result reports..." />
		<delete dir="${testcase.path}/reports" failonerror="false"/>
		<delete dir="${testcase.path}/logs" failonerror="false"/>
		<echo message="Clean deploy result reports compeleted." />
	</target>

	<target name="test-exception-testcases" depends="clean-test-reports">
		<echo message="Begin test exception testcases..." />

		<mkdir dir="${testcase.path}/reports" />
		<tstamp />
		<echo message="perform the exception testcases,with testcase.path=${testcase.path}" />


		<foreach target="test-one-suite" param="test.suite.fullname">
			<path>
				<dirset dir="${testcase.path}/ant-tests" includes="*" />
			</path>

			<param name="testcase.path" value="${testcase.path}" />
		</foreach>

		<tar destfile="${junitreport.path}/${junitreport.tar.file.name}" basedir="${testcase.path}" includes="reports/**" compression="gzip">
		</tar>

	</target>

	<target name="test-one-suite" depends="">
		<basename property="test.suite.name" file="${test.suite.fullname}" />
		<echo message="Execute test suite(${test.suite.name}) test.suite.fullname=${test.suite.fullname}" />
		<property name="test.suit.class.name" value="com.sequoiadb.testcase.exceptions.${test.suite.name}" />

		<echo file="${testcase.path}/reports/TEST-${test.suit.class.name}.xml" message="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; ?&gt;
		            &lt;testsuite errors=&quot;0&quot; failures=&quot;0&quot; hostname=&quot;ubun-test2&quot; name=&quot;${test.suit.class.name}&quot; tests=&quot;1&quot; time=&quot;0.55&quot; timestamp=&quot;2013-02-28T08:15:31&quot;&gt;" />

		<foreach target="test-one-case" param="test.case.fullname">
			<fileset dir="${test.suite.fullname}" includes="*.xml" />
			<param name="test.suite.name" value="${test.suite.name}" />
			<param name="test.suite.class.name" value="${test.suite.class.name}" />
		</foreach>

		<echo file="${testcase.path}/reports/TEST-${test.suit.class.name}.xml" message="
			&lt;system-out&gt;
			&lt;![CDATA[${on screen}]]&gt;
			&lt;/system-out&gt;
			&lt;/testsuite&gt;" append="true" />

	</target>

	<target name="test-one-case" depends="">
		<basename property="test.case.name" file="${test.case.fullname}" suffix=".xml" />
		<echo message="Execute test case(${test.suite.name}.${test.case.name}) test.suite.fullname=${test.case.fullname}" />

		<echo file="${testcase.path}/reports/TEST-${test.suite.class.name}.xml" append="true" message="&lt;testcase classname=&quot;${test.suite.class.name}&quot; name=&quot;${test.case.name}&quot; time=&quot;0.437&quot;&gt;" />

		<mkdir dir="${testcase.path}/logs/TEST-${test.suite.class.name}/" />
		<record name="${testcase.path}/logs/TEST-${test.suite.class.name}/${test.case.name}.log" action="start" />
		<antfetch antfile="${test.case.fullname}" target="main" return="ret.code, err.msg">
			<property name="cmds.path" value="${testcase.path}/cmds/bin" />
			<property name="ant.libs.path" value="${testcase.path}/ant-lib" />
		</antfetch>
		
		<record name="${testcase.path}/logs/TEST-${test.suite.class.name}/${test.case.name}.log" action="stop" />


		<if>
			<not>
				<equals arg1="retcode" arg2="0" />
			</not>
			<then>
				<loadfile property="ant.test.message" srcFile="${testcase.path}/logs/${testcase.path}/reports/TEST-${test.suite.class.name}/${test.case.name}.log" failonerror="false" />
				<echo file="${testcase.path}/reports/TEST-${test.suite.class.name}.xml" append="true" message="&lt;failure message=&quot;${error.msg}&quot; type=&quot;junit.framework.AssertionFailedError&quot;&gt;${ant.test.message}
		&lt;/failure&gt;" />
			</then>
		</if>


		<echo file="${testcase.path}/reports/TEST-${test.suite.class.name}.xml" append="true" message="&lt;/testcase&gt;" />

	</target>
</project>