<project name="build-ant-testcase" default="build-ant-testcase">

	<target name="clean-ant-testcase">
		<echo message="Begin to clean ant testcase evn.." />
		<delete dir="${deploy.path}/hlt/ant_testcase/" failonerror="false" />
		<echo message="Clean ant testcase evn completed." />
	</target>

	<target name="build-ant-testcase" depends="clean-ant-testcase">
		<echo message="build the base-bussiness testcases,with build.testcase=${build.testcases}" />

		<mkdir dir="${deploy.path}/hlt/ant_testcase/ant-lib" />
		<mkdir dir="${deploy.path}/hlt/ant_testcase/ant-tests" />
		<mkdir dir="${deploy.path}/hlt/ant_testcase/cmds/bin" />

		<copy todir="${deploy.path}/hlt/ant_testcase/ant-lib/">
			<fileset dir="${build.testcases}/ant-lib" includes="**/*" />
		</copy>

		<copy todir="${deploy.path}/hlt/ant_testcase/ant-tests/">
			<fileset dir="${build.testcases}/ant-tests" includes="**/*" />
		</copy>

		<copy todir="${deploy.path}/hlt/ant_testcase/cmds/bin">
			<fileset dir="${build.testcases}/cmds/bin" includes="**/*" />
		</copy>
	</target>

</project>