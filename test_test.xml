
<!--@param ${deploy.host.name} :  The host name for deploy test scripts and install software-->
<!--@param ${test.machine.deploy.path}:  The path where deploy install package and test scripts-->
<!--@param ${coord.service.port}:  coord's service port-->
<!--@param ${is.standalone.mode}:  the flag whether start with standalone mode-->

<project name="copy_tar_build" default="copy_tar_build">
	<property file="${WORKSPACE}/ci/ci.properties.${os.publish.name}" />
	<property file="${WORKSPACE}/ci/build.version" />

	
	<target name="clean" depends="">
		
		
		
		
	</target>
	
	<target name="copy_tar_build" depends="clean">
		
		
	  <rename src="${WORKSPACE}/ci/chenfoo" dest="chenfoolOK">
	  <property environment="env" />
	  
	  <echo message="delete the file ${copy_tar}/build.version" />
		<exec command="${STAF.PATH}/bin/staf LOCAL FS DELETE ENTRY ${copy_tar}/build.version RECURSE CONFIRM" failifexecutionfails="true">
			<env key="PATH" path="${env.PATH}:${STAF.PATH}/bin" />
			<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
			<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
		</exec>
	  
	  
	  <echo message="updata the deploy version" />
	  <replace file="${WORKSPACE}/ci/build.version" value="build_version=${BUILD_NUMBER}.${deploy.tar.file.name}">
			 <replacefilter token="build_version=${build_version}" />
	  </replace>
	  
	  <exec command="${STAF.PATH}\bin\staf LOCAL FS COPY FILE ${WORKSPACE}/ci/build.version TODIRECTORY ${copy_tar} TOMACHINE LOCAL" dir="${STAF.PATH}" failonerror="true" failifexecutionfails="true">
			<env key="PATH" path="${env.PATH}:${STAF.PATH}/bin" />
			<env key="LD_LIBRARY_PATH" path="${env.LD_LIBRARY_PATH}:${STAF.PATH}/lib" />
			<env key="STAFCONVDIR" path="${STAF.PATH}/codepage" />
		</exec>
		
		
		<echo message="build is over " />
	</target>


</project>



