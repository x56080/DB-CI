<project>
    <shortName>sequoiadb</shortName>
    <fullName>SequoiaDB Server</fullName>
    <version>1.0</version>
    <componentList>
        <component>
            <name>SequoiaDB</name>
            <description>SequoiaDB Component</description>
            <canBeEdited>1</canBeEdited>
            <selected>1</selected>
            <show>1</show>
            <folderList>
                <folder>
                    <description>Program Files</description>
                    <destination>${installdir}</destination>
                    <name>programfiles</name>
                    <platforms>all</platforms>
                    <distributionFileList>
                        <distributionDirectory>
                            <allowWildcards>1</allowWildcards>
                            <includeFiles></includeFiles>
                            <origin>../doc</origin>
                        </distributionDirectory>
                        <distributionDirectory>
                            <origin>../conf</origin>
                        </distributionDirectory>
                        <distributionDirectory>
                            <origin>../client/samples</origin>
                        </distributionDirectory>
                    </distributionFileList>
                    <shortcutList>
                        <shortcut>
                            <comment>Uninstall</comment>
                            <exec>${installdir}/${uninstallerName}</exec>
                            <icon></icon>
                            <name>Uninstall ${product_fullname}</name>
                            <path>${installdir}</path>
                            <platforms>all</platforms>
                            <runAsAdmin>0</runAsAdmin>
                            <runInTerminal>0</runInTerminal>
                            <windowsExec>${installdir}/${uninstallerName}.exe</windowsExec>
                            <windowsExecArgs></windowsExecArgs>
                            <windowsIcon></windowsIcon>
                            <windowsPath>${installdir}</windowsPath>
                        </shortcut>
                    </shortcutList>
                </folder>
                <folder>
                    <description>Program Files</description>
                    <destination>${installdir}</destination>
                    <name>programfileslinux</name>
                    <platforms>linux</platforms>
                    <distributionFileList>
                        <distributionFile>
                            <origin>../script/sdbinst.sh</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../script/sequoiadb</origin>
                        </distributionFile>
                    </distributionFileList>
                </folder>
                <folder>
                    <description>Program Files</description>
                    <destination>${installdir}</destination>
                    <name>programfileswindows</name>
                    <platforms>windows</platforms>
                </folder>
                <folder>
                    <description>binary files</description>
                    <destination>${installdir}/bin</destination>
                    <name>binWin</name>
                    <platforms>windows</platforms>
                    <distributionFileList>
                        <distributionDirectory>
                            <allowWildcards>1</allowWildcards>
                            <includeFiles>*/*.exe</includeFiles>
                            <origin>../bin/*</origin>
                        </distributionDirectory>
                    </distributionFileList>
                </folder>
                <folder>
                    <description>binary files</description>
                    <destination>${installdir}/bin</destination>
                    <name>binLinux</name>
                    <platforms>linux</platforms>
                    <distributionFileList>
                        <distributionDirectory>
                            <allowWildcards>1</allowWildcards>
                            <includeFiles>*/sdb*</includeFiles>
                            <origin>../bin/*</origin>
                        </distributionDirectory>
                    </distributionFileList>
                </folder>
                <folder>
                    <description>cInclude</description>
                    <destination>${installdir}/include/C/include</destination>
                    <name>cInclude</name>
                    <platforms>all</platforms>
                    <distributionFileList>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/client/jstobs.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/client/base64.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/client/client.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/include/ossTypes.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/include/core.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/include/ossErr.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/include/ossFeat.h</origin>
                        </distributionFile>
                    </distributionFileList>
                </folder>
                <folder>
                    <description>cppInclude</description>
                    <destination>${installdir}/include/CPP/include</destination>
                    <name>cppInclude</name>
                    <platforms>all</platforms>
                    <distributionFileList>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/client/client.cpp</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/client/jstobs.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/client/base64.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/include/ossTypes.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/include/core.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/include/ossErr.h</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../SequoiaDB/engine/include/ossFeat.h</origin>
                        </distributionFile>
                    </distributionFileList>
                </folder>
                <folder>
                    <description>library</description>
                    <destination>${installdir}/lib</destination>
                    <name>libWin</name>
                    <platforms>windows</platforms>
                    <distributionFileList>
                        <distributionFile>
                            <origin>../build/win32/dd/clientc/engine/sdbc.dll</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../build/win32/dd/clientcpp/engine/sdbcpp.dll</origin>
                        </distributionFile>
                    </distributionFileList>
                </folder>
                <folder>
                    <description>library</description>
                    <destination>${installdir}/lib</destination>
                    <name>libLinux</name>
                    <platforms>linux</platforms>
                    <distributionFileList>
                        <distributionFile>
                            <origin>../build/linux2/dd/clientc/engine/libsdbc.so</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../build/linux2/dd/clientcpp/engine/libsdbcpp.so</origin>
                        </distributionFile>
                    </distributionFileList>
                </folder>
                <folder>
                    <description>java</description>
                    <destination>${installdir}/java</destination>
                    <name>java</name>
                    <platforms>all</platforms>
                </folder>
            </folderList>
            <startMenuShortcutList>
                <startMenuShortcut>
                    <comment>Uninstall ${product_fullname}</comment>
                    <name>Uninstall ${product_fullname}</name>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsExec>${installdir}/${uninstallerName}.exe</windowsExec>
                    <windowsExecArgs></windowsExecArgs>
                    <windowsIcon></windowsIcon>
                    <windowsPath>${installdir}/</windowsPath>
                </startMenuShortcut>
            </startMenuShortcutList>
        </component>
    </componentList>
    <postInstallationActionList>
        <createWindowsService>
            <displayName>SequoiaDB Cluster Manager</displayName>
            <program>C:\sequoiadb\bin\sdbcm.exe</program>
            <programArguments></programArguments>
            <serviceName>sdbcm</serviceName>
            <startType>auto</startType>
        </createWindowsService>
    </postInstallationActionList>
    <preUninstallationActionList>
        <deleteWindowsService>
            <displayName>SequoiaDB Cluster Manager</displayName>
            <serviceName>sdbcm</serviceName>
        </deleteWindowsService>
    </preUninstallationActionList>
    <enableRollback>1</enableRollback>
    <enableTimestamp>1</enableTimestamp>
    <saveRelativePaths>1</saveRelativePaths>
    <vendor>SequoiaDB</vendor>
    <parameterList>
        <directoryParameter>
            <name>installdir</name>
            <description>Installer.Parameter.installdir.description</description>
            <explanation>Installer.Parameter.installdir.explanation</explanation>
            <value></value>
            <default>${platform_install_prefix}/${product_shortname}-${product_version}</default>
            <allowEmptyValue>0</allowEmptyValue>
            <ask>yes</ask>
            <cliOptionName>prefix</cliOptionName>
            <mustBeWritable>yes</mustBeWritable>
            <mustExist>0</mustExist>
            <width>40</width>
        </directoryParameter>
    </parameterList>
</project>

