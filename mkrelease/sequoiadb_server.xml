<project>
    <shortName>sequoiadb</shortName>
    <fullName>SequoiaDB Server</fullName>
    <version>1.0</version>
    <installerFilename>${product_shortname}-${product_version}-${platform}-installer.${platform_exec_suffix}</installerFilename>
    <allowLanguageSelection>1</allowLanguageSelection>
    <componentList>
        <component>
            <name>SequoiaDB</name>
            <description>SequoiaDB Component</description>
            <canBeEdited>1</canBeEdited>
            <selected>1</selected>
            <show>1</show>
            <folderList>
                <folder>
                    <description>Program Files</description>
                    <destination>${installdir}</destination>
                    <name>programfiles</name>
                    <platforms>all</platforms>
                    <distributionFileList>
                        <distributionDirectory>
                            <allowWildcards>1</allowWildcards>
                            <origin>sequoiadb/*</origin>
                        </distributionDirectory>
                    </distributionFileList>
                </folder>
            </folderList>
        </component>
    </componentList>
    <readyToInstallActionList>
        <addUser>
            <abortOnError>1</abortOnError>
            <customErrorMessage>Failed to create user: ${username}</customErrorMessage>
            <password>${userpasswd}</password>
            <showMessageOnError>1</showMessageOnError>
            <username>${username}</username>
            <ruleList>
                <userTest>
                    <logic>not_exists</logic>
                    <username>${username}</username>
                </userTest>
            </ruleList>
        </addUser>
        <runProgram>
            <program>echo</program>
            <programArguments>"NAME=sdbcm" &gt; /etc/default/sequoiadb</programArguments>
            <ruleList>
                <platformTest>
                    <type>linux</type>
                </platformTest>
            </ruleList>
        </runProgram>
        <runProgram>
            <program>echo</program>
            <programArguments>"SDBADMIN_USER=${username}" &gt;&gt; /etc/default/sequoiadb</programArguments>
            <ruleList>
                <platformTest>
                    <type>linux</type>
                </platformTest>
            </ruleList>
        </runProgram>
        <runProgram>
            <program>echo</program>
            <programArguments>"INSTALL_DIR=${installdir}" &gt;&gt; /etc/default/sequoiadb</programArguments>
            <ruleList>
                <platformTest>
                    <type>linux</type>
                </platformTest>
            </ruleList>
        </runProgram>
    </readyToInstallActionList>
    <postInstallationActionList>
        <createWindowsService>
            <abortOnError>1</abortOnError>
            <customErrorMessage>Failed to create Windows Service: sdbcm</customErrorMessage>
            <description>SequoiaDB Cluster Manager</description>
            <displayName>SequoiaDB Cluster Manager</displayName>
            <program>${installdir}\bin\sdbcm.exe</program>
            <programArguments></programArguments>
            <serviceName>sdbcm</serviceName>
            <startType>auto</startType>
        </createWindowsService>
        <addUnixService>
            <customErrorMessage>Failed to create Linux Service: sdbcm</customErrorMessage>
            <description>SequoiaDB Cluster Manager</description>
            <name>sdbcm</name>
            <program>${installdir}/sequoiadb</program>
        </addUnixService>
        <changePermissions files="${installdir}/bin/{*,*/*}" permissions="0755">
            <customErrorMessage>Failed to change file permissions: ${installdir}/bin</customErrorMessage>
        </changePermissions>
        <startWindowsService>
            <customErrorMessage>Failed to start Windows Service: sdbcm</customErrorMessage>
            <delay>15000</delay>
            <displayName>SequoiaDB Cluster Manager</displayName>
            <serviceName>sdbcm</serviceName>
            <ruleList>
                <windowsServiceTest>
                    <condition>exists</condition>
                    <service>sdbcm</service>
                </windowsServiceTest>
            </ruleList>
        </startWindowsService>
    </postInstallationActionList>
    <preUninstallationActionList>
        <kill>
            <customErrorMessage>Failed to stop sdbcm</customErrorMessage>
            <name>sdbcm</name>
            <path>${installdir}/bin</path>
            <ruleList>
                <processTest>
                    <logic>is_running</logic>
                    <name>sdbcm</name>
                </processTest>
            </ruleList>
        </kill>
        <kill>
            <customErrorMessage>Failed to stop sequoiadb</customErrorMessage>
            <name>sequoiadb</name>
            <path>${install}/bin/</path>
            <ruleList>
                <processTest>
                    <logic>is_running</logic>
                    <name>sequoiadb</name>
                </processTest>
            </ruleList>
        </kill>
        <stopWindowsService>
            <abortOnError>1</abortOnError>
            <customErrorMessage>Failed to stop Windows Service: sdbcm</customErrorMessage>
            <delay>15000</delay>
            <displayName>SequoiaDB Cluster Manager</displayName>
            <serviceName>sdbcm</serviceName>
            <ruleList>
                <windowsServiceTest>
                    <condition>is_running</condition>
                    <service>sdbcm</service>
                </windowsServiceTest>
            </ruleList>
        </stopWindowsService>
        <deleteWindowsService>
            <abortOnError>1</abortOnError>
            <displayName>SequoiaDB Cluster Manager</displayName>
            <serviceName>sdbcm</serviceName>
        </deleteWindowsService>
        <removeUnixService>
            <name>sdbcm</name>
        </removeUnixService>
    </preUninstallationActionList>
    <postUninstallationActionList>
        <deleteFile>
            <path>/etc/default/sequoiadb</path>
            <ruleList>
                <platformTest>
                    <type>linux</type>
                </platformTest>
                <fileExists>
                    <path>/etc/default/sequoiadb</path>
                </fileExists>
            </ruleList>
        </deleteFile>
        <deleteUser>
            <customErrorMessage>Failed to delete user: ${username}</customErrorMessage>
            <showMessageOnError>1</showMessageOnError>
            <username>${username}</username>
        </deleteUser>
    </postUninstallationActionList>
    <allowedLanguages>en zh_CN</allowedLanguages>
    <defaultUnixOwner>${username}</defaultUnixOwner>
    <enableRollback>1</enableRollback>
    <enableTimestamp>1</enableTimestamp>
    <requireInstallationByRootUser>1</requireInstallationByRootUser>
    <saveRelativePaths>1</saveRelativePaths>
    <singleInstanceCheck>1</singleInstanceCheck>
    <vendor>SequoiaDB</vendor>
    <installationAbortedActionList>
        <deleteUser>
            <username>${username}</username>
        </deleteUser>
        <deleteWindowsService>
            <displayName>SequoiaDB Cluster Manager</displayName>
            <serviceName>sdbcm</serviceName>
            <ruleList>
                <windowsServiceTest>
                    <condition>exists</condition>
                    <service>sdbcm</service>
                </windowsServiceTest>
            </ruleList>
        </deleteWindowsService>
        <removeUnixService>
            <name>sdbcm</name>
        </removeUnixService>
        <deleteFile>
            <abortOnError>0</abortOnError>
            <path>/etc/default/sequoiadb</path>
            <ruleList>
                <platformTest>
                    <type>linux</type>
                </platformTest>
                <fileExists>
                    <path>/etc/default/sequoiadb</path>
                </fileExists>
            </ruleList>
        </deleteFile>
    </installationAbortedActionList>
    <parameterList>
        <directoryParameter>
            <name>installdir</name>
            <description>Installer.Parameter.installdir.description</description>
            <explanation>Installer.Parameter.installdir.explanation</explanation>
            <value></value>
            <default>${platform_install_prefix}/${product_shortname}</default>
            <allowEmptyValue>0</allowEmptyValue>
            <ask>yes</ask>
            <cliOptionName>prefix</cliOptionName>
            <mustBeWritable>yes</mustBeWritable>
            <mustExist>0</mustExist>
            <width>40</width>
        </directoryParameter>
        <parameterGroup>
            <name>user_data</name>
            <title>User data</title>
            <explanation>Please insert the desired username and password</explanation>
            <value></value>
            <default></default>
            <parameterList>
                <stringParameter>
                    <name>username</name>
                    <description>User Name</description>
                    <explanation></explanation>
                    <value>sdbadmin</value>
                    <default>sdbadmin</default>
                    <allowEmptyValue>0</allowEmptyValue>
                    <width>40</width>
                </stringParameter>
                <passwordParameter>
                    <name>userpasswd</name>
                    <title>User Password</title>
                    <description>Password</description>
                    <explanation></explanation>
                    <value></value>
                    <default>sequoiadb;</default>
                    <allowEmptyValue>0</allowEmptyValue>
                    <descriptionRetype>Re-enter</descriptionRetype>
                    <width>20</width>

	<!-- throw an error if password is empty -->
	<validationActionList>
                        <throwError>
                            <text>You need to provide a non-empty password</text>
                            <ruleList>
                                <compareText logic="equals" text="${userpasswd}" value=""/>
                            </ruleList>
                        </throwError>
                    </validationActionList>
                </passwordParameter>
            </parameterList>
        </parameterGroup>
        <stringParameter>
            <name>platform</name>
            <description></description>
            <explanation></explanation>
            <value>${platform_name}</value>
            <default>${platform_name}</default>
            <allowEmptyValue>0</allowEmptyValue>
            <ask>0</ask>
            <cliOptionShow>0</cliOptionShow>
            <width>40</width>
        </stringParameter>
    </parameterList>
</project>

