<project name="test-all" default="test-all">

	<target name="clean-test" depends="">
		<echo message="Begin to clean test env..." />
		<delete dir="${test.basedir}/deploy" />
		<echo message="Clean deploy env compeleted." />
	</target>

	<target name="test-all" depends="clean-test">
		<echo message="Begin test all..." />
		<untar src="${test.basedir}/${deploy.filename}" dest="${test.basedir}" compression="gzip" />
		<property file="${test.basedir}/deploy/ci.properties" />

		<property environment="env" />
		<ant antfile="${test.basedir}/deploy/install-singlehost.xml">
			<property name="install.package.path" value="${test.basedir}/deploy" />
			<property name="install.package.name" value="${install.tar.file.name}" />
			<property name="host.ip" value="${host.ip}" />
		</ant>

		<ant antfile="${test.basedir}/depoly/exec-basic-testcases.xml">
			<property name="testcase.path" value="${test.basedir}/deploy/hlt" />
			<property name="sdb.path" value="${test.basedir}/deploy/sequoiadb/bin" />
		</ant>
	</target>
</project>
