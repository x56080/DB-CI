<!--@param WORKSPACE where is the jenkins's path -->
<project name="exec-driver-test" default="exec-driver-test">


		<property name="java_test.dir" value="${WORKSPACE}/deploy/hlt/drivers_testcases/java" />
    <property name="java_test.jar.dir" value="${WORKSPACE}/deploy/hlt/drivers_testcases/lib/java_test.jar" />
		<property name="sequoiadb.jar.dir" value="${WORKSPACE}/deploy/hlt/drivers_testcases/lib/sequoiadb.jar" />
		<property name="deploy.path" value="${WORKSPACE}/deploy" />
    


<target name="clean-env" depends="">
	 <delete dir="${java_test.dir}" failonerror="false" />
	 <mkdir dir="${java_test.dir}" />
	 <unjar src="${WORKSPACE}/deploy/hlt/drivers_testcases/lib/java_test.jar" dest="${java_test.dir}" />
	 
	 
</target>
<target name="exec-driver-test" depends="clean-env">
   <junit printsummary="on" fork="true" showoutput="true">
      <classpath>
      	 <pathelement path="/usr/share/java/junit.jar" />
         <pathelement path="${sequoiadb.jar.dir}" />
         <pathelement path="${java_test.jar.dir}" />
         
      </classpath>
      <formatter type="xml" />
      <batchtest todir="${WORKSPACE}/test_log">
     	  <fileset dir="${java_test.dir}">
     	  	   <include name="**/*.*" />
        </fileset>
      </batchtest>
   </junit>

</target>
</project>
