<project name="build-srccode" default="main">

	<target name="compile-src" depends="">
		<taskdef resource="net/sf/antcontrib/antlib.xml">
			<classpath>
				<pathelement location="/usr/share/java/ant-contrib.jar" />
			</classpath>
		</taskdef>


		<echo message="Begin to compile source code..." />

		<property name="compile.arg.line.default" value="--all" />
		<if>
			<equals arg1="${compile.debug}" arg2="true" />
			<then>
				<echo message="compile.debug is ture" />
				<property name="compile.arg.line" value="${compile.arg.line.default} --dd" />
				<echo message="${compile.arg.line}" />
			</then>
			<else>
				<echo message="compile.debug is false" />
				<property name="compile.arg.line" value="${compile.arg.line.default}" />
				<echo message="${compile.arg.line}" />
			</else>
		</if>


		<echo message="exec scons ${compile.arg.line}" />
		<exec executable="scons" dir="${WORKSPACE}/sequoiadb" failonerror="true">
			<arg line="${compile.arg.line}" />
		</exec>
		<echo message="compile source code completed." />
	</target>



	<target name="mk-release" depends="compile-src">
		<echo message="Begin to make relase package ..." />
		<property name="RELEASE_DIR" value="${WORKSPACE}/${release.dirname}" />
		<property name="CODE_DIR" value="${WORKSPACE}/sequoiadb" />

		<mkdir dir="${RELEASE_DIR}/sequoiadb/bin" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/lib" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/include" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/samples" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/java" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/doc" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/conf/samples" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/conf/local" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/include/CPP/include" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/include/C/include" />

		<copy file="${CODE_DIR}/sequoiadb" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/sdb" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/sdbbp" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/sdbcm" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/sdbstart" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/sdbstop" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/sdblist" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/sdbinspt" todir="${RELEASE_DIR}/sequoiadb/bin" />

		<copy todir="${RELEASE_DIR}/sequoiadb/lib">
			<fileset dir="${CODE_DIR}/client/C/lib/" includes="*.so" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/lib">
			<fileset dir="${CODE_DIR}/client/CPP/lib/" includes="*.so" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/include/C/include">
			<fileset dir="${CODE_DIR}/client/C/include/" includes="*.h" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/include/CPP/include">
			<fileset dir="${CODE_DIR}/client/CPP/include/" includes="*.h" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/samples">
			<fileset dir="${CODE_DIR}/client/samples/" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/java">
			<fileset dir="${CODE_DIR}/java/jdk_linux64/" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/conf/samples/">
			<fileset dir="${CODE_DIR}/conf/samples/" />
		</copy>


		<delete includeemptydirs="true">
			<fileset dir="${RELEASE_DIR}/sequoiadb" includes="**/.svn" />
		</delete>

		<tar destfile="${deploy.path}/${install.packege.name}" basedir="${RELEASE_DIR}" includes="sequoiadb/**" compression="gzip" />

		<echo message="Make relase package completed." />
	</target>

	<target name="main" depends="mk-release">


	</target>

</project>