<project name="build-srccode" default="main">
	<property name="CODE_DIR" value="${WORKSPACE}/sequoiadb" />

	<target name="compile-src" depends="">
		<taskdef resource="net/sf/antcontrib/antlib.xml">
			<classpath>
				<pathelement location="/usr/share/java/ant-contrib.jar" />
			</classpath>
		</taskdef>


		<echo message="Begin to compile source code..." />

		<if>
			<equals arg1="${compile.debug}" arg2="true" />
			<then>
				<echo message="compile.debug is ture" />
				<property name="compile.arg.line" value="--dd" />
				<echo message="${compile.arg.line}" />
			</then>
			<else>
				<echo message="compile.debug is false" />
				<property name="compile.arg.line" value="" />
				<echo message="${compile.arg.line}" />
			</else>
		</if>


		<echo message="exec scons ${compile.arg.line}  --all -j 4" />
		<exec executable="scons" dir="${WORKSPACE}/sequoiadb" failonerror="true">
			<arg line="${compile.arg.line} --all -j 4" />
		</exec>

		<exec executable="scons" dir="${WORKSPACE}/sequoiadb/driver/java" failonerror="true">
			<arg line="${compile.arg.line}" />
		</exec>

		<exec executable="scons" dir="${WORKSPACE}/sequoiadb/driver/php5" failonerror="true">
			<arg line="${compile.arg.line} --phpversion=5.3.3" />
		</exec>

		<if>
			<equals arg1="${compile.debug}" arg2="true" />
			<then>
				<property name="java.driver.jar.name" value="sequoiadb-debug.jar" />
			</then>
			<else>
				<property name="java.driver.jar.name" value="sequoiadb-release.jar" />
			</else>
		</if>

		<copy file="${CODE_DIR}/driver/java/${java.driver.jar.name}" tofile="${CODE_DIR}/driver/java//sequoiadb.jar" />
		<echo message="compile source code completed." />
	</target>



	<target name="mk-release" depends="compile-src">
		<echo message="Begin to make relase package ..." />
		<property name="RELEASE_DIR" value="${WORKSPACE}/${release.dirname}" />
		<property name="CODE_DIR" value="${WORKSPACE}/sequoiadb" />
		<property file="${CODE_DIR}/misc/ci/ci.properties" />

		<mkdir dir="${RELEASE_DIR}/sequoiadb/bin" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/lib" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/include" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/samples" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/java/jdk" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/doc" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/conf/samples" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/conf/local" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/conf/log" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/include/CPP/include" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/include/C/include" />
		<mkdir dir="${RELEASE_DIR}/sequoiadb/www" />


		<if>
			<equals arg1="${compile.debug}" arg2="true" />
			<then>
				<property name="build.result.dir" value="dd" />
			</then>
			<else>
				<property name="build.result.dir" value="normal" />
			</else>
		</if>

		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/engine/sequoiadb" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/shell/engine/sdb" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/shell/engine/sdbbp" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/engine/sdbcm" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/engine/sdbstart" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/engine/sdbstop" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/engine/sdblist" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/engine/sdbinspt" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/engine/sdbcmart" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/engine/sdbcmtop" todir="${RELEASE_DIR}/sequoiadb/bin" />
		<copy file="${CODE_DIR}/build/linux2/${build.result.dir}/engine/sdbpdlog" todir="${RELEASE_DIR}/sequoiadb/bin" />

		<copy todir="${RELEASE_DIR}/sequoiadb/lib">
			<fileset dir="${CODE_DIR}/client/C/lib/" includes="*.so" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/lib">
			<fileset dir="${CODE_DIR}/client/CPP/lib/" includes="*.so" />
		</copy>

		<copy file="${CODE_DIR}/driver/php5/build/${build.result.dir}/libsequoiadb.so" tofile="${RELEASE_DIR}/sequoiadb/lib/libsdbphp.so" />

		<copy todir="${RELEASE_DIR}/sequoiadb/include/C/include">
			<fileset dir="${CODE_DIR}/client/C/include/" includes="*.h" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/include/CPP/include">
			<fileset dir="${CODE_DIR}/client/CPP/include/" includes="*.h" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/www">
			<fileset dir="${CODE_DIR}/client/admin/admin2.0" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/samples">
			<fileset dir="${CODE_DIR}/client/samples/" />
		</copy>

		<copy file="${CODE_DIR}/driver/java/sequoiadb.jar" tofile="${RELEASE_DIR}/sequoiadb/java/sequoiadb.jar" />

		<copy todir="${RELEASE_DIR}/sequoiadb/java/jdk">
			<fileset dir="${CODE_DIR}/java/jdk_linux64/" />
		</copy>

		<copy todir="${RELEASE_DIR}/sequoiadb/conf/samples/">
			<fileset dir="${CODE_DIR}/conf/samples/" />
		</copy>
		<copy file="${CODE_DIR}/conf/sdbcm.conf" todir="${RELEASE_DIR}/sequoiadb/conf" />

		<!--copy file="${CODE_DIR}/script/sdbinst.sh" todir="${RELEASE_DIR}/sequoiadb/" />
		<replaceregexp file="${RELEASE_DIR}/sequoiadb/sdbinst.sh" match="&#13;&#10;" replace="&#10;" flags="g"/ -->

		<copy file="${CODE_DIR}/script/sequoiadb" todir="${RELEASE_DIR}/sequoiadb/" />
		<replaceregexp file="${RELEASE_DIR}/sequoiadb/sequoiadb" match="&#13;&#10;" replace="&#10;" flags="g" />

		<copy todir="${RELEASE_DIR}/sequoiadb/doc">
			<fileset dir="${CODE_DIR}/doc/out" />
		</copy>

		<delete includeemptydirs="true">
			<fileset dir="${RELEASE_DIR}/sequoiadb" includes="**/.svn" />
		</delete>

		<copy file="${CODE_DIR}/misc/ci/mkrelease/sequoiadb_server.xml" todir="${RELEASE_DIR}/" />

		<exec dir="${RELEASE_DIR}/" executable="builder">
			<arg line="build sequoiadb_server.xml --setvars project.version=${project.version}  --setvars platform=${os.and.platform} --setvars project.outputDirectory=${deploy.path}" />
		</exec>

		<tar destfile="${RELEASE_DIR}/${project.name}-${project.version}-${os.and.platform}.tar.gz" basedir="${RELEASE_DIR}" includes="sequoiadb/**" compression="gzip" />

		<echo message="Make relase package completed." />
	</target>

	<target name="main" depends="mk-release">


	</target>

</project>