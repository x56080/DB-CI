<!--@param ${testcase.path}: The path where test case direcotry.-->
<!--@param ${install.path}: The path where sequoiadb installed.-->
<project name="test-basic-testcases" default="test-basic-testcases">

	<target name="clean-test-reports" depends="">
		<echo message="Begin to clean test result reports..." />
		<delete dir="${testcase.path}/reports" />
		<echo message="Clean deploy result reports compeleted." />
	</target>

	<target name="test-basic-testcases" depends="clean-test-reports">
		<echo message="Begin test basic testcases..." />

		<taskdef resource="net/sf/antcontrib/antlib.xml">
			<classpath>
				<pathelement location="/usr/share/java/ant-contrib.jar" />
			</classpath>
		</taskdef>

		<mkdir dir="${testcase.path}/reports" />
		<tstamp />
		<echo message="perform the base-bussiness testcases,with testcase.path=${testcase.path}" />
		<chmod file="${install.path}/bin/sdb" perm="u+x" />
		<property name="js.name" value="createCS_1.js" />

		<foreach target="test-one-case" param="js.fullname">
			<fileset dir="${testcase.path}/js" includes="*.js" />

			<param name="testcase.path" value="${testcase.path}" />
			<param name="sdb.fullname" value="${install.path}/bin/sdb" />
			<param name="testcases.jar.fullname" value="${testcase.path}/sequoiadb-hlt.jar" />
			<param name="junit.jar.fullname" value="${testcase.path}/lib/junit.jar" />
		</foreach>

		<tar destfile="${junitreport.path}/${junitreport.tar.file.name}" basedir="${testcase.path}" includes="reports/**" compression="gzip">
		</tar>

	</target>

	<target name="test-one-case" depends="">

		<basename property="js.name" file="${js.fullname}" suffix=".js" />

		<junit printsummary="true" timeout="2000" haltonfailure="no">
			<sysproperty key="jsFullName" value="${js.fullname}" />
			<sysproperty key="sdbProcFullName" value="${sdb.fullname}" />

			<classpath>
				<pathelement location="${testcases.jar.fullname}" />
				<pathelement location="${junit.jar.fullname}" />
			</classpath>
			<formatter type="xml" />

			<test name="com.sequoiadb.testcase.basebussiness.collectionstest" outfile="TEST.com.sequoiadb.testcase.basebussiness.test_${js.name}" todir="${testcase.path}/reports" />

			<!--batchtest fork="yes" todir="${testcase.path}/reports">
						<fileset>
							<includes name="com/sequoiadb/testcase/basebussiness/**/*.class"/>
						</filese>
					</batchtest-->
		</junit>

		<replaceregexp file="${testcase.path}/reports/TEST.com.sequoiadb.testcase.basebussiness.test_${js.name}.xml" match="collectionstest" replace="test_${js.name}" />
		<replaceregexp file="${testcase.path}/reports/TEST.com.sequoiadb.testcase.basebussiness.test_${js.name}.xml" match="testCaseForAllJSScript" replace="testCase_${js.name}" />
	</target>
</project>