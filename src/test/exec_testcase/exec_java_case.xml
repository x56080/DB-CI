<!-- ============================================================================
@description:  exec java testcase, junit or testng
@parameter:    TEST_TYPE              eg: CONFIGURETEST
               testcase_type          eg: tdd_c
               testcase_dir           eg: /tmp/ci/testcase/tdd/c
               report_dir             eg：/tmp/ci/report/tdd_c
@author:       Ting YU 2016-11-2
============================================================================= -->

<project default="exec_java_testcase" basedir="../../../">     
   <taskdef resource="net/sf/antcontrib/antlib.xml">
      <classpath>
         <pathelement location="${basedir}/lib/ant-contrib-1.0b2.jar" />
      </classpath>
   </taskdef>
   <import file="${basedir}/src/test/exec_testcase/common.xml" />
   
   <target name="exec_java_testcase">
      <property file="${basedir}/src/conf/test.conf" />
      <property name="user" value="${ROOT_USER}" />
      <property name="passwd" value="${ROOT_PWD}" />
      <propertycopy name="testhost_list" from="${plat_form}_${TEST_TYPE}_${DEPLOY_MODE}_HOST" />
      <propertyregex property="firsthost" input="${testhost_list}" regexp=",(.*)" replace="" defaultValue="${testhost_list}"/>

      <hostinfo prefix="host"/>
      <var name="rsync_tools_mvn" value="bash ${CI_WORK_DIR}/utils.sh -m sync_test_tools -v mvn -d ${RESOURCE_PATH}/java"/>
      <sshexec host="${host.ADDR4}"
               username="${user}"
               password="${passwd}"
               trust="true"
               command="${rsync_tools_mvn};source /etc/profile"/>

      <mkdir dir="${report_dir}"/>
      <for param="fullfilename">
         <path>
            <fileset dir="${INSTALL_DIR}/java" includes="sequoiadb-driver-*.jar"/>
         </path>
         <sequential>
            <propertyregex property="tmpversion" input="@{fullfilename}" regexp="${INSTALL_DIR}/java/sequoiadb-driver-(.*).jar" select="\1" casesensitive="false"/>
         </sequential>
      </for>
      <for param="s3fullfilename">
         <path>
            <fileset dir="${INSTALL_DIR}/tools/sequoias3/java" includes="sequoias3-client-*.jar"/>
         </path>
         <sequential>
            <propertyregex property="s3tmpversion" input="@{s3fullfilename}" regexp="${INSTALL_DIR}/tools/sequoias3/java/sequoias3-client-(.*).jar" select="\1" casesensitive="false"/>
         </sequential>
      </for>
      <if>
         <or>
             <equals arg1="${TEST_TYPE}" arg2="CONFIGURETEST"/>
             <equals arg1="${TEST_TYPE}" arg2="MVCCTEST"/>
         </or>
         <then>
            <replaceregexp file="${testcase_dir}/configure.xml"
                           match='"CONFTOOL"(.*)value="(.*)"' 
                           replace='"CONFTOOL"\1value="${testcase_dir}/../../tools/changeConf.js"' 
                           flags="g" 
                           byline="true" 
                           encoding="utf-8"/>
         </then>
      </if>
      <if>
         <equals arg1="${TEST_TYPE}" arg2="RELIABILITYTEST"/>
         <then>
            <replace file="${testcase_dir}/../../../testcase/tools/runtest_java.xml" token="-DDSHOSTNAME=@{dshostname} -DDSSVCNAME=@{dssvcname}" value=""/>
            <replaceStrOfCfg testBasedir="${testcase_dir}/../../../testcase"/>

            <propertyregex property="firsthost" input="${testhost_list}" regexp=",(.*)" replace="" defaultValue="${testhost_list}"/>
            <ant antfile="${testcase_dir}/../../../testcase/tools/runtest_java.xml" target="exec_testcase">
               <property name="casedir" value="${testcase_dir}"/>
               <property name="reportdir" value="${report_dir}"/>
               <property name="serial_number" value="${serial_number}"/>
               <property name="sdbdriver" value="${tmpversion}" />
               <property name="sdbdriverDir" value="${INSTALL_DIR}/java" />
               <property name="hostname" value="${firsthost}"/>
               <property name="svcname" value="${SVCNAME}"/>
               <property name="eshostname" value="${ES_IP}"/>
               <property name="essvcname" value="${ES_PORT_RELIABILITY}"/>
               <property name="testhost_list" value="${testhost_list}"/>
               <property name="remoteuser" value="${user}" />
               <property name="remotepwd" value="${passwd}" />
               <property name="rootpwd" value="${passwd}" />
               <property name="rsrvnodedir" value="${INSTALL_DIR}/database/" />
               <property name="branch" value="master" />
               <property name="backup_tmpnode_logpath" value="${BACKUP_TMPNODE_LOGPATH}/database" />
            </ant>
         </then>
         <elseif>
            <equals arg1="${TEST_TYPE}" arg2="SYNCTEST"/>
            <then>
               <propertyregex property="firsthost" input="${testhost_list}" regexp=",(.*)" replace="" defaultValue="${testhost_list}"/>
               <replace file="${test_basedir}/tools/runtest_java.xml" token="-DDSHOSTNAME=@{dshostname}" value="-DRSRVNODEDIR=${INSTALL_DIR}/database"/>
               <replaceStrOfCfg testBasedir="${test_basedir}"/>

               <ant antfile="${test_basedir}/tools/runtest_java.xml" target="exec_testcase">
                  <property name="casedir" value="${testcase_dir}"/>
                  <property name="testcasetype" value="${testcase_type}"/>
                  <property name="reportdir" value="${report_dir}"/>
                  <property name="sdbdriver" value="${tmpversion}" />
                  <property name="sdbdriverDir" value="${INSTALL_DIR}/java" />
                  <property name="hostname" value="${firsthost}"/>
                  <property name="svcname" value="${SVCNAME}"/>
                  <property name="eshostname" value="${ES_IP}"/>
                  <property name="essvcname" value="${ES_PORT}"/>
                  <property name="s3svcname" value="${S3SVCNAME}"/>
                  <property name="s3client" value="${s3tmpversion}" />
		          <property name="remoteuser" value="${user}" />
		          <property name="remotepwd" value="${passwd}" />
                  <property name="rsrvnodedir" value="${INSTALL_DIR}/database/" />
                  <property name="branch" value="master" />
                  <property name="s3clientDir" value="${INSTALL_DIR}/tools/sequoias3/java"/>
                  <property name="testhost_list" value="${testhost_list}"/>
               </ant>
            </then>
         </elseif>
         <else>
            <propertyregex property="firsthost" input="${testhost_list}" regexp=",(.*)" replace="" defaultValue="${testhost_list}"/>
            <replace file="${test_basedir}/tools/runtest_java.xml" token="-DS3HOSTNAME=${host.ADDR4}" value="-DS3HOSTNAME=@{hostname}"/>
            <replaceStrOfCfg testBasedir="${test_basedir}"/>

            <ant antfile="${test_basedir}/tools/runtest_java.xml" target="exec_testcase">
               <property name="casedir" value="${testcase_dir}"/>
               <property name="testcasetype" value="${testcase_type}"/>
               <property name="reportdir" value="${report_dir}"/>
               <property name="sdbdriver" value="${tmpversion}" />
               <property name="sdbdriverDir" value="${INSTALL_DIR}/java" />
               <property name="hostname" value="${firsthost}"/>
               <property name="svcname" value="${SVCNAME}"/>
               <property name="eshostname" value="${ES_IP}"/>
               <property name="essvcname" value="${ES_PORT}"/>
               <property name="s3svcname" value="${S3SVCNAME}"/>
               <property name="s3client" value="${s3tmpversion}" />
               <property name="remoteuser" value="${user}" />
               <property name="remotepwd" value="${passwd}" />
               <property name="s3clientDir" value="${INSTALL_DIR}/tools/sequoias3/java"/>
               <property name="testhost_list" value="${testhost_list}"/>
               <property name="rootpwd" value="${passwd}" />
               <property name="rsrvnodedir" value="${INSTALL_DIR}/database/" />
               <property name="branch" value="master" />
               <property name="backup_tmpnode_logpath" value="${BACKUP_TMPNODE_LOGPATH}/database" />
            </ant>
         </else>
      </if>
      <if>
         <available file="${testcase_dir}/output/junitreports" type="dir"/>
         <then>
            <copy todir="${report_dir}">
               <fileset dir="${testcase_dir}/output/junitreports"/>
            </copy> 
            <modifytestngreport reportdir="${report_dir}" layer="${testcase_type}"/>
         </then>
      </if>
      
      <if>
         <available file="${testcase_dir}/output/junitreports" type="dir"/>
         <then>
            <countstr str="&lt;/failure&gt;" resultproperty="fail_end_num">
               <path-elements>
                  <fileset dir="${testcase_dir}/output/junitreports" includes="**/*.xml"/>
               </path-elements>
            </countstr>
         </then>
         <else>
            <var name="fail_end_num" value="0"/>
         </else>
      </if>

      <if>
         <available file="${testcase_dir}/output/junitreports" type="dir"/>
         <then>
            <countstr str="&lt;/error&gt;" resultproperty="error_end_num">
               <path-elements>
                  <fileset dir="${testcase_dir}/output/junitreports" includes="**/*.xml"/>
               </path-elements>
            </countstr>
         </then>
         <else>
            <var name="error_end_num" value="0"/>
         </else>
      </if>
     
      <if>
         <and>
            <equals arg1="${BREAK_ON_FAILURE}" arg2="true"/>
            <or>
               <not>
                  <equals arg1="${fail_end_num}" arg2="0"/>
               </not>
               <not>
                  <equals arg1="${error_end_num}" arg2="0"/>
               </not>
            </or>
         </and>
         <then>
            <touch file="${report_dir}/.TESTCASE_FAIL"/>
            <for list="${testhost_list}" param="testhost" parallel="true">
               <sequential>  
                  <if>
                     <equals arg1="${plat_form}" arg2="ARM" />
                     <then>
                         <!--property name="user" value="${user}" /-->
                         <!--property name="passwd" value="Admin@2048" /-->
                         <scp localFile="${report_dir}/.TESTCASE_FAIL" 
                              remoteTodir="${user}@@@{testhost}:${CI_WORK_DIR}/report"
                              password="${passwd}"
                              trust="true"/> 
                     </then>
                     <else>
                         <staf location="local" service="FS"
                               request="COPY FILE ${report_dir}/.TESTCASE_FAIL TODIRECTORY ${CI_WORK_DIR}/report TOMACHINE @{testhost}"
                               throwBuildException="1"/>
                     </else>
                  </if>
               </sequential>
            </for>
         </then>
      </if>   
   </target>

   <macrodef name="replaceStrOfCfg">
      <attribute name="testBasedir"/>
      <sequential>
         <echo message="testcase dir: @{testBasedir}"/>
         <property name="cfg_file_list"
                   value="testng,largedata,configure,smoke,sync,testng_release,s3testng"/>

         <for list="${cfg_file_list}" param="cfgPrefix" delimiter=",">
            <sequential>
               <var name="find_ret" unset="true"/>
               <exec executable="find" outputproperty="find_ret">
                  <arg line="@{testBasedir}"/>
                  <arg line="-name"/>
                  <arg line="@{cfgPrefix}.xml"/>
               </exec>

               <var name="find_ret.length" unset="true"/>
               <length string="${find_ret}" property="find_ret.length"/>

               <if>
                  <not>
                     <equals arg1="${find_ret.length}" arg2="0"/>
                  </not>
                  <then>
                     <echo message="@{cfgPrefix}.xml"/>

                     <var name="find_ret_split" unset="true"/>
                     <propertyregex property="find_ret_split" input="${find_ret}" regexp="\n"
                                    replace="," global="true"/>
                     <!-- 不存在换行符时${find_ret_split}会直接等于${find_ret_split} -->
                     <if>
                        <contains string="${find_ret_split}" substring="find_ret_split"/>
                        <then>
                           <property name="find_ret_split" value="${find_ret}"/>
                        </then>
                     </if>

                     <for list="${find_ret_split}" param="fileItem" delimiter=",">
                        <sequential>
                           <if>
                              <available file="@{fileItem}"/>
                              <then>
                                 <var name="fileItem" unset="true"/>
                                 <echo message="replace cfg path in @{fileItem}"/>
                                 <!-- 替换配置文件中的路径 -->
                                 <replace file="@{fileItem}" token="/opt/sequoiadb/database/" value="${INSTALL_DIR}/database/"/>
                                 <replace file="@{fileItem}" token="/tmp/javatest" value="${CI_WORK_DIR}/javatest/"/>
                                 <replace file="@{fileItem}" token="/data/sequoiadb/cidatabase" value="${METADATA_DIR}/cidatabase"/>
                                 <replace file="@{fileItem}" token="/data/sequoiadb/cidatabase" value="${METADATA_DIR}/cidatabase"/>
                                 <replace file="@{fileItem}" token="/opt/sequoiadb/database/" value="${INSTALL_DIR}/database/"/>
                              </then>
                              <else>
                                 <echo message="@{fileItem} file is unavailable"/>
                              </else>
                           </if>
                        </sequential>
                     </for>
                  </then>
                  <else>
                     <echo message="@{cfgPrefix}.xml not found in dir: @{testBasedir}"/>
                  </else>
               </if>
            </sequential>
         </for>
      </sequential>
   </macrodef>

   <macrodef name="modifytestngreport">
      <attribute name="reportdir"/>
      <attribute name="layer" />
      <sequential>
         <property file="${basedir}/src/conf/test.conf" />
         
         <var name="cluster_host_info" value=""/>
         <for list="${testhost_list}" param="testhost">
            <sequential>
               <hostinfo prefix="prefix@{testhost}" host="@{testhost}"/>
               <var name="cluster_host_info" value="${cluster_host_info} @{testhost}/${prefix@{testhost}.ADDR4}"/>
            </sequential>
         </for>
         
         
         <hostinfo prefix="host" />
         <var name="ms1" value="EXECUTE HOST: ${host.NAME}/${host.ADDR4}&#10;&#10;"/>    
         <var name="ms2" value="CLUSTER HOST:${cluster_host_info}&#10;&#10;"/>            
         <var name="backup_reltdir" value="${TEST_TYPE}_${DEPLOY_MODE}_${BUILD_NUMBER}.tar.gz"/>
         <var name="download_url" value="&#10;DOWNLOAD DIAGLOG :&#10;http://192.168.28.27:8081/${backup_reltdir}&#10;" />
         <replaceregexp match='&lt;\/failure&gt;' 
                        replace='${download_url}&lt;\/failure&gt;' 
                        flags="g" 
                        byline="true" 
                        encoding="utf-8">
            <fileset dir="@{reportdir}" includes="**/*"/>
         </replaceregexp>
         <replaceregexp match='&lt;failure(.*)&gt;' 
                        replace='&lt;failure\1&gt;      ${ms1}      ${ms2}' 
                        flags="g" 
                        byline="true" 
                        encoding="utf-8">
            <fileset dir="@{reportdir}" includes="**/*"/>
         </replaceregexp>
         <replaceregexp match='&lt;\/error&gt;' 
                        replace='${download_url}&lt;\/error&gt;' 
                        flags="g" 
                        byline="true" 
                        encoding="utf-8">
            <fileset dir="@{reportdir}" includes="**/*"/>
         </replaceregexp>
         <replaceregexp match='&lt;error(.*)&gt;' 
                        replace='&lt;error\1&gt;      ${ms1}      ${ms2}' 
                        flags="g" 
                        byline="true" 
                        encoding="utf-8">
            <fileset dir="@{reportdir}" includes="**/*"/>
         </replaceregexp>
         <replaceregexp match='testsuite(.*)name="com\.sequoiadb\.(.*?)\.(.*)"' 
                        replace='testsuite\1name="\2"' 
                        flags="g" 
                        byline="true" 
                        encoding="utf-8">
            <fileset dir="@{reportdir}" includes="**/*"/>
         </replaceregexp>
         <replaceregexp match='classname="com\.sequoiadb\.(.*)"' 
                        replace='classname="@{layer}.\1"' 
                        flags="g" 
                        byline="true" 
                        encoding="utf-8">
            <fileset dir="@{reportdir}" includes="**/*"/>
         </replaceregexp>
         <replaceregexp match='classname="com\.sequoiadb\.(.*)"' 
                        replace='classname="@{layer}.\1"' 
                        flags="g" 
                        byline="true" 
                        encoding="utf-8">
            <fileset dir="@{reportdir}" includes="**/*"/>
         </replaceregexp>
         <replaceregexp match='name="(.*)"(.*)classname="@{layer}\.(.*?)\.(.*)"' 
                        replace='name="\4.\1"\2classname="@{layer}.\3"' 
                        flags="g" 
                        byline="true" 
                        encoding="utf-8">
            <fileset dir="@{reportdir}" includes="**/*"/>
         </replaceregexp>
      </sequential>
   </macrodef>
   
   <macrodef name="countstr">
      <attribute name="resultproperty"/>
      <attribute name="str"/>
      <element name="path-elements"/>
      <sequential>
         <var name="@{resultproperty}" unset="true"/>
         <resourcecount property="@{resultproperty}">
         <tokens>
            <concat>
               <filterchain>
                  <tokenfilter>
                     <containsstring contains="@{str}"/>
                  </tokenfilter>
               </filterchain>
               <path-elements/>
            </concat>
         </tokens>
         </resourcecount>
      </sequential>
   </macrodef>
</project>
