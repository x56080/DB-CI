<!-- ============================================================================
@description:  install and deploy sequoiadb
@parameter:    DEPLOY_MODE: G1D3|G3D3|STANDALONE, from jenkins configure page
               TEST_TYPE: from build.xml
               testhost_list: from build.xml
@author:       Ting YU 2016-10-19
============================================================================= -->

<project default="main" basedir="../../">  
   <property file="${basedir}/src/conf/test.conf" /> 
   <taskdef resource="net/sf/antcontrib/antlib.xml">
      <classpath>
         <pathelement location="${basedir}/lib/ant-contrib-1.0b2.jar" />
      </classpath>
   </taskdef>
   <taskdef name="staf" classname="com.ibm.staf.ant.taskdef.STAF" >
      <classpath>
         <pathelement location="${basedir}/lib/STAFAnt.jar" />
      </classpath>
   </taskdef>
   <property file="${basedir}/src/conf/test.conf" />
   <var name="user" value="${ROOT_USER}" />
   <var name="passwd" value="${ROOT_PWD}" />
   
   <target name="main">  
      <propertyregex property="firsthost" input="${testhost_list}" regexp=",(.*)" replace="" defaultValue="${testhost_list}"/>
      <antcall target="stopnode"/>
      <if>
         <equals arg1="${TEST_TYPE}" arg2="SMOKETEST"/>
         <then>
            <antcall target="clear_cluster"/>
            <antcall target="ready_bin_and_conf"/>
            <antcall target="ready_cm"/>
         </then>
         <else>
            <antcall target="uninstall"/>
            <antcallback target="ready_package" return="package_name"/><!--variable package_name used in target install--> 
            <antcall target="install"/>
         </else>
      </if>  
      <antcall target="change_limits"/>
      <if>
         <equals arg1="${ISMVCC}" arg2="true"/>
         <then>
            <antcall target="ready_mvcc_spt"/>
         </then>
      </if>
      <antcall target="deploy"/> 
      <antcall target="ready_es_environment"/>

   </target>
   
   <target name="clear_cluster">
      <var name="cmd_clear_cluster" 
           value="${INSTALL_DIR}/bin/sdbcmtop;${INSTALL_DIR}/bin/sdbstop -t all;rm -rf ${INSTALL_DIR};rm -rf ${METADATA_DIR} "/>
      <for list="${testhost_list}" param="testhost" parallel="true">
         <sequential> 
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND ${cmd_clear_cluster} WAIT 10m RETURNSTDOUT RETURNSTDERR"
                  throwBuildException=""/>
         </sequential>
      </for>
   </target>
   
   <target name="ready_bin_and_conf">
      <for list="${testhost_list}" param="testhost" parallel="true">
         <sequential> 
            <staf location="@{testhost}" service="FS"
                  request="CREATE DIRECTORY ${INSTALL_DIR} FULLPATH"
                  throwBuildException="1"/>
                  
            <for param="fullfilename">
               <path>
                  <fileset dir="${WORKSPACE}/release" includes="*.tar.gz"/>
               </path>
               <sequential>
                  <staf location="local" service="FS"
                        request="COPY FILE @{fullfilename} TODIRECTORY ${INSTALL_DIR} TOMACHINE @{testhost}"
                        throwBuildException="1"/>
                  <local name="tarname"/>
                  <propertyregex property="tarname" input="@{fullfilename}" regexp="${WORKSPACE}/release/(.*.tar.gz)" select="\1" casesensitive="false"/>
                  <!--untar-->
                  <staf location="@{testhost}" service="PROCESS"
                        request="START SHELL COMMAND tar zxvf ${INSTALL_DIR}/${tarname} -C ${INSTALL_DIR} WAIT 10m RETURNSTDERR"
                        throwBuildException="1"/>
                        
                  <!--clear tar.gz-->
                  <staf location="@{testhost}" service="FS"
                        request="DELETE ENTRY ${INSTALL_DIR}/${tarname} RECURSE CONFIRM"
                        throwBuildException=""/>
               </sequential>
            </for>
         </sequential>
      </for>
   </target>
   
   <target name="ready_cm">
      <var name="cmd_start_cm" 
           value="${INSTALL_DIR}/bin/sdbcmart"/>
      <for list="${testhost_list}" param="testhost" parallel="true">
         <sequential> 
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND chmod 777 ${INSTALL_DIR}/bin -R WAIT 10m RETURNSTDOUT RETURNSTDERR"
                  throwBuildException=""/>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND ${cmd_start_cm} WAIT 10m RETURNSTDOUT RETURNSTDERR"
                  throwBuildException=""/>
         </sequential>
      </for>
   </target>
   
   <target name="uninstall" depends="">
      <var name="getinstalldircmd" value="[ -e /etc/default/sequoiadb ] &amp;&amp; awk -F= '$1==&quot;INSTALL_DIR&quot;{print $2}' /etc/default/sequoiadb"/>
      <for list="${testhost_list}" param="testhost" parallel="true">
         <sequential>
            <var name="DEFAULT_INSTALL_DIR_RET" unset="true"/>
            <var name="DEFAULT_INSTALL_DIR" unset="true"/>
            <sshexec host="@{testhost}"
                     outputproperty="DEFAULT_INSTALL_DIR_RET"
                     username="${SDBADMIN_USER}"
                     password="${SDBADMIN_PWD}"
                     failonerror="false"
                     trust="true"
                     command="${getinstalldircmd}" />
            <propertyregex property="DEFAULT_INSTALL_DIR" input="${DEFAULT_INSTALL_DIR_RET}" regexp="\n" replace="" global="true"/>
            <echo message="@{testhost} DEFAULT_INSTALL_DIR=${DEFAULT_INSTALL_DIR}"/>
            <echo message="@{testhost} INSTALL_DIR=${INSTALL_DIR}"/>
            <if>
               <equals arg1="${INSTALL_DIR}" arg2="${DEFAULT_INSTALL_DIR}"/>
               <else>
                  <echo message="@{testhost}: ${DEFAULT_INSTALL_DIR}!=${INSTALL_DIR}"/>
                  <staf location="@{testhost}" service="PROCESS"
                        request="START SHELL COMMAND ${DEFAULT_INSTALL_DIR}/bin/stpstop WAIT 10m RETURNSTDERR"
                        throwBuildException=""/>
                  <staf location="@{testhost}" service="PROCESS"
                        request="START SHELL COMMAND ${DEFAULT_INSTALL_DIR}/uninstall --mode unattended WAIT 10m RETURNSTDOUT RETURNSTDERR"
                        throwBuildException="1"/>
                  <staf location="@{testhost}" service="FS"
                        request="DELETE ENTRY ${DEFAULT_INSTALL_DIR} RECURSE CONFIRM"
                        throwBuildException=""/>
               </else>
            </if>

            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND ${INSTALL_DIR}/bin/stpstop WAIT 10m RETURNSTDERR"
                  throwBuildException=""/>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND ${INSTALL_DIR}/uninstall --mode unattended WAIT 10m RETURNSTDOUT RETURNSTDERR"
                  throwBuildException="1"/>
            <staf location="@{testhost}" service="FS"
                  request="DELETE ENTRY ${INSTALL_DIR} RECURSE CONFIRM"
                  throwBuildException=""/>
            <staf location="@{testhost}" service="FS"
                  request="DELETE ENTRY ${METADATA_DIR} RECURSE CONFIRM"
                  throwBuildException=""/>
            <if>
               <equals arg1="${TEST_TYPE}" arg2="PERFORMANCETEST_TPCC" />
               <then>
                  <for list="${TPCC_DBPATH_LIST}" param="dbpath" parallel="false">
                     <sequential>
                        <staf location="@{testhost}" service="FS"
                              request="DELETE ENTRY @{dbpath} RECURSE CONFIRM"
                              throwBuildException=""/>
                     </sequential>
                  </for>
               </then>
               <elseif>
                  <equals arg1="${TEST_TYPE}" arg2="RELIABILITYTEST"/>
                  <then>
                     <for list="${RELIABILITYTEST_DBPATH_LIST}" param="dbpath" parallel="false">
                        <sequential>
                           <staf location="@{testhost}" service="FS"
                                 request="DELETE ENTRY @{dbpath} RECURSE CONFIRM"
                                 throwBuildException=""/>
                        </sequential>
                     </for>
                  </then>
               </elseif>
            </if>

            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND ps -ef |grep sdbseadapter |grep -v grep | awk '{print $2}' |  xargs kill -9  WAIT 10m RETURNSTDOUT RETURNSTDERR"
                  throwBuildException=""/>
         </sequential>
      </for>
   </target>
   
   <target name="ready_package" depends="">
      <!--get run package name-->
      <property name="package_dir" location="${WORKSPACE}/archive/current" />
      <first id="package_fullname">
         <fileset dir="${package_dir}" includes="sequoiadb*.run" />
      </first>
      <property name="package_fullname" location="${toString:package_fullname}" />
      <basename property="package_name_part" file="${package_fullname}" suffix=".run"/>
      <property name="package_name" value="${package_name_part}.run" />
      <staf location="localhost" service="FS"
            request="CREATE DIRECTORY ${CI_WORK_DIR} FULLPATH"
            throwBuildException="1"/>


      <!--copy run package to remote host-->
      <for list="${testhost_list}" param="testhost" parallel="true">
         <sequential>
            <!--<staf location="@{testhost}" service="FS" request="CREATE DIRECTORY ${CI_WORK_DIR} FULLPATH" throwBuildException="1"/>-->
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND mkdir -p ${CI_WORK_DIR};rm -rf ${CI_WORK_DIR}/* WAIT 1m"
                  throwBuildException="1"/>
            <staf location="local" service="FS"
                  request="COPY FILE ${package_fullname} TODIRECTORY ${CI_WORK_DIR} TOMACHINE @{testhost}"
                  throwBuildException="1"/>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND chmod +x ${CI_WORK_DIR}/${package_name} WAIT 1m"
                  throwBuildException="1"/>     
         </sequential>
      </for>
   </target>
   
   <target name="install" depends="">       
      <for list="${testhost_list}" param="testhost" parallel="true">
         <sequential> 
            <staf location="@{testhost}" service="FS"
                  request="QUERY ENTRY ${INSTALL_DIR}"
                  resultPrefix="check_dir"
                  throwBuildException=""/>
            <if>
               <equals arg1="${check_dir.rc}" arg2="48" />
               <else>
                  <fail message="exec: QUERY ENTRY ${INSTALL_DIR}, expect directory not exists. expect return code is 48, actual: ${check_dir.rc}"/>
               </else>
            </if>
            <var name="createvarcmd" value="mkdir -p /var/sequoiadb; chown -R sdbadmin:sdbadmin_group /var/sequoiadb"/>
            <var name="createdatacmd" value="mkdir -p ${METADATA_DIR}; chown -R sdbadmin:sdbadmin_group ${METADATA_DIR}"/>
            <staf location="@{testhost}" service="PROCESS" request="START SHELL COMMAND ${createvarcmd} WAIT 20m STDERRTOSTDOUT RETURNSTDOUT" throwBuildException="1"/>
            <staf location="@{testhost}" service="PROCESS" request="START SHELL COMMAND ${createdatacmd} WAIT 20m STDERRTOSTDOUT RETURNSTDOUT" throwBuildException="1"/>

            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND ${CI_WORK_DIR}/${package_name} --prefix ${INSTALL_DIR} --mode unattended WAIT 20m STDERRTOSTDOUT RETURNSTDOUT"
                  resultPrefix="install"
                  throwBuildException="1"/>
            <propertyregex property="install_rc" input="${install.result}" regexp="Return\ Code:\ (.*)\n" select="\1"/>
            <if>
               <equals arg1="${install_rc}" arg2="0" />
               <else>
                  <fail message="exec: ${CI_WORK_DIR}/${package_name} --mode unattended, return code is not 0"/>
               </else>
            </if>
         </sequential>         
      </for>
   </target>
   
   <target name="change_limits">
      <for list="${testhost_list}" param="testhost" parallel="true">
         <sequential> 
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND ${INSTALL_DIR}/bin/sdbcmtop WAIT 5m STDERRTOSTDOUT RETURNSTDOUT"
                  resultPrefix="cmstop"
                  throwBuildException="1"/>
                  
            <if>
               <equals arg1="${ISMVCC}" arg2="true"/>
               <then>
                  <staf location="@{testhost}" service="PROCESS"
                        request="START SHELL COMMAND sed -i 's/#DiagLevel=3/DiagLevel=5/g' ${INSTALL_DIR}/conf/sdbcm.conf WAIT 10m STDERRTOSTDOUT RETURNSTDOUT" 
                        throwBuildException=""/>
               </then>
            </if>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND sed -i 's/core_file_size=0/core_file_size=-1/g' ${INSTALL_DIR}/conf/limits.conf WAIT 10m STDERRTOSTDOUT RETURNSTDOUT"
                  resultPrefix="sed"
                  throwBuildException="1"/>
            <propertyregex property="sed_rc" input="${sed.result}" regexp="Return\ Code:\ (.*)\n" select="\1"/>
            <if>
               <equals arg1="${sed_rc}" arg2="0" />
               <else>
                  <fail message="exec: sed 's/core_file_size=0/core_file_size=-1/g' ${INSTALL_DIR}/conf/limits.conf, return code is not 0"/>
               </else>
            </if>
            
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND ${INSTALL_DIR}/bin/sdbcmart WAIT 5m STDERRTOSTDOUT RETURNSTDOUT"
                  resultPrefix="sdbcmart"
                  throwBuildException="1"/>
         </sequential>         
      </for>
   </target>
   
   <target name="ready_es_environment">
      <!--clear es environment-->
      <var name="IDXPREFIX" unset="true"/>
      <propertyregex property="IDXPREFIX" input="${firsthost}" regexp="-" replace="_"/> 
      <var name="esport" value="${ES_PORT}"/>
      <if>
         <equals arg1="${TEST_TYPE}" arg2="RELIABILITYTEST"/>
         <then>
            <var name="esport" value="${ES_PORT_RELIABILITY}"/>
         </then>
      </if>
      <var name="cmd" value="echo 'http://${ES_IP}:${esport}/${IDXPREFIX}*' | tr A-Z a-z | xargs curl -XDELETE"/>
      <sshexec host="${ES_IP}" username="${user}" password="${passwd}" trust="true" command="${cmd}" />

      <property name="getdatalist" value="ls -l ${INSTALL_DIR}/database/data |awk 'NR>1{ret=$NF&quot;,&quot;ret}END{print ret}'"/>
      <sshexec host="${firsthost}" outputproperty="datalist1" username="${SDBADMIN_USER}" password="${SDBADMIN_PWD}" trust="true" command="${getdatalist}" />
      <propertyregex property="datalist" input="${datalist1}" regexp="\n" replace="" global="true"/>

      <hostinfo prefix="host" />
<!--      <if>-->
<!--         <equals arg1="${TEST_TYPE}" arg2="RELIABILITYTEST"/>-->
<!--         <then>-->
<!--            <staf location="${firsthost}" service="FS"-->
<!--                  request="COPY DIRECTORY ${INSTALL_DIR}/database/data TODIRECTORY ${CI_WORK_DIR}/database/data TOMACHINE ${host.NAME} RECURSE"-->
<!--                  throwBuildException="1"/>-->
<!--            <staf location="${firsthost}" service="FS"-->
<!--                  request="COPY FILE ${INSTALL_DIR}/conf/samples/sdbseadapter.conf TODIRECTORY ${CI_WORK_DIR}/conf/samples TOMACHINE ${host.NAME}"-->
<!--                  throwBuildException="1"/>-->
<!--         </then>-->
<!--      </if>-->
      <if>
         <or>
            <equals arg1="${DEPLOY_MODE}" arg2="G1D3"/>
            <equals arg1="${DEPLOY_MODE}" arg2="G3D3"/>
         </or>
         <then>
            <mkdir dir="${CI_WORK_DIR}/conf/samples/"/>
            <mkdir dir="${CI_WORK_DIR}/conf/sdbseadpter/"/>
            <scp file="${user}@${firsthost}:${INSTALL_DIR}/conf/samples/*" password="${passwd}" trust="true"
                 todir="${CI_WORK_DIR}/conf/samples"/>

            <for list="${datalist}" param="dataidx" delimiter=",">
               <sequential>
                  <echo message="@{dataidx}"/>
                  <var name="svcname" unset="true"/>
                  <var name="svcname" value="@{dataidx}"/>
                  <mkdir dir="${CI_WORK_DIR}/conf/sdbseadpter/${svcname}"/>
                  <copy file="${CI_WORK_DIR}/conf/samples/sdbseadapter.conf" todir="${CI_WORK_DIR}/conf/sdbseadpter/${svcname}"/>

                  <replace file="${CI_WORK_DIR}/conf/sdbseadpter/${svcname}/sdbseadapter.conf" token="searchenginehost=localhost" value="searchenginehost=${ES_IP}"/>
                  <replace file="${CI_WORK_DIR}/conf/sdbseadpter/${svcname}/sdbseadapter.conf" token="searchengineport=9200" value="searchengineport=${esport}"/>
                  <replace file="${CI_WORK_DIR}/conf/sdbseadpter/${svcname}/sdbseadapter.conf" token="diaglevel=3" value="diaglevel=5"/>
                  <replace file="${CI_WORK_DIR}/conf/sdbseadpter/${svcname}/sdbseadapter.conf" token="optimeout=10000" value="optimeout=60000"/>
                  <replaceregexp file="${CI_WORK_DIR}/conf/sdbseadpter/${svcname}/sdbseadapter.conf" match="(.*)idxprefix=" replace="idxprefix=${IDXPREFIX}" byline="true"/>
                  <replaceregexp file="${CI_WORK_DIR}/conf/sdbseadpter/${svcname}/sdbseadapter.conf" match="(.*)datasvcname=" replace="datasvcname=${svcname}" byline="true"/>

                  <math result="expect_cnt" operand1="${svcname}" operation="+" operand2="10" datatype="int"/>
                  <replace file="${CI_WORK_DIR}/conf/sdbseadpter/${svcname}/sdbseadapter.conf" token="# svcname=" value="svcname=${expect_cnt}"/>
               </sequential>
            </for>
            <!--copy to other host -->
            
            <for list="${testhost_list}" param="testhost">
               <sequential>
                  <if>
                     <equals arg1="@{testhost}" arg2="${host.NAME}" />
                     <else>
                        <echo message="${user}@@@{testhost}:${CI_WORK_DIR}/conf/sdbseadpter"/>
                        <sshexec host="@{testhost}"
                                 username="${user}"
                                 password="${passwd}"
                                 trust="true"
                                 command="mkdir -p ${INSTALL_DIR}/conf/sdbseadpter" />
                        <scp todir="${user}@@@{testhost}:${INSTALL_DIR}/conf/sdbseadpter"
                             password="${passwd}"
                             trust="true">
                           <fileset dir="${CI_WORK_DIR}/conf/sdbseadpter"/>
                        </scp>
                     </else>
                  </if>
                  <sshexec host="@{testhost}"
                           username="${user}"
                           password="${passwd}"
                           trust="true"
                           command="chown sdbadmin:sdbadmin_group ${INSTALL_DIR}/conf/sdbseadpter -R" />
                  <sshexec host="@{testhost}"
                           username="${user}"
                           password="${passwd}"
                           trust="true"
                           command="chmod 755 ${INSTALL_DIR}/conf/sdbseadpter -R" />

                  <for list="${datalist}" param="dataidx" delimiter=",">
                     <sequential>
                        <echo message="@{dataidx}"/>
                        <var name="svcname" unset="true"/>
                        <var name="svcname" value="@{dataidx}"/>

                        <sshexec host="@{testhost}"
                                 username="${user}"
                                 password="${passwd}"
                                 trust="true"
                                 command="nohup ${INSTALL_DIR}/bin/sdbseadapter -c ${INSTALL_DIR}/conf/sdbseadpter/${svcname} -p ${IDXPREFIX} >/dev/null 2>&amp;1 &amp;"/>
                     </sequential>
                  </for>
               </sequential>
            </for>

         </then>
      </if>
   </target>
   
   <target name="ready_mvcc_spt">
      <hostinfo prefix="host" />
      <for list="${testhost_list}" param="testhost" >
         <sequential>
            <if>
               <not>
                  <equals arg1="@{testhost}" arg2="${firsthost}"/>
               </not>
               <then>
                  <var name="stpserver02" value="@{testhost}" />
               </then>
            </if>
         </sequential>
      </for>
      <for list="${testhost_list}" param="testhost" >
         <sequential>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND mkdir -p ${INSTALL_DIR}/conf/stp WAIT 5m RETURNSTDERR"
                  throwBuildException="1"/>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND echo serverlist=${firsthost}:9622,${stpserver02}:9622 >> ${INSTALL_DIR}/conf/stp/stp.conf WAIT 5m RETURNSTDERR"
                  throwBuildException="1"/>
            
            <if>
               <or>
                  <equals arg1="@{testhost}" arg2="${firsthost}"/>
                  <equals arg1="@{testhost}" arg2="${stpserver02}"/>
               </or>
               <then>
                  <var name="role" value="server"/>
               </then>
               <else>
                  <var name="role" value="client"/>
               </else>
            </if>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND echo role=${role} >> ${INSTALL_DIR}/conf/stp/stp.conf WAIT 5m RETURNSTDERR"
                  throwBuildException="1"/>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND echo diaglevel=5 >> ${INSTALL_DIR}/conf/stp/stp.conf WAIT 5m RETURNSTDERR"
                  throwBuildException="1"/>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND chown sdbadmin:sdbadmin_group ${INSTALL_DIR}/conf/stp -R WAIT 10m RETURNSTDERR"
                  throwBuildException="1"/>
            <staf location="@{testhost}" service="PROCESS"
                  request="START SHELL COMMAND ${INSTALL_DIR}/bin/stpstart WAIT 10m RETURNSTDERR"
                  throwBuildException="1"/>
         </sequential>
      </for>
   </target>
   
   <target name="deploy" depends="">
      <!--format host list-->
      <propertyregex property="testhost_jsarr" input="${testhost_list}" regexp="," replace="','" defaultValue="${testhost_list}"/>
      <var name="testhost_jsarr" value="['${testhost_jsarr}']"/>
      
      <!--create dbPath-->
      <if>
         <equals arg1="${TEST_TYPE}" arg2="PERFORMANCETEST_TPCC" />
         <then>
            <for list="${testhost_list}" param="testhost" parallel="true">
               <sequential>
                  <for list="${TPCC_DBPATH_LIST}" param="dbpath" parallel="false">
                     <sequential>
                        <staf location="@{testhost}" service="FS"
                              request="CREATE DIRECTORY @{dbpath}"
                              throwBuildException="1"/>
                        <staf location="@{testhost}" service="PROCESS"
                              request="START SHELL COMMAND chown sdbadmin:sdbadmin_group @{dbpath} WAIT 1m"
                              throwBuildException="1"/>     
                     </sequential>
                  </for>
               </sequential>
            </for>
         </then>
         <elseif>
            <equals arg1="${TEST_TYPE}" arg2="RELIABILITYTEST"/>
            <then>
               <for list="${testhost_list}" param="testhost" parallel="true">
                  <sequential>
                     <for list="${RELIABILITYTEST_DBPATH_LIST}" param="dbpath" parallel="false">
                        <sequential>
                           <staf location="@{testhost}" service="FS"
                                 request="CREATE DIRECTORY @{dbpath}"
                                 throwBuildException="1"/>
                           <staf location="@{testhost}" service="PROCESS"
                                 request="START SHELL COMMAND chown sdbadmin:sdbadmin_group @{dbpath} WAIT 1m"
                                 throwBuildException="1"/>     
                        </sequential>
                     </for>
                  </sequential>
               </for>
            </then>
         </elseif>
      </if>
      
      <!--copy sdb shell to localhost-->
      <sshexec host="localhost"
               username="${ROOT_USER}"
               password="${ROOT_PWD}"
               trust="true"
               command="rm -rf ${CI_WORK_DIR}/*" />
      <sshexec host="localhost"
               username="${ROOT_USER}"
               password="${ROOT_PWD}"
               trust="true"
               command="mkdir -p ${CI_WORK_DIR};" />
      <sshexec host="localhost"
               username="${ROOT_USER}"
               password="${ROOT_PWD}"
               trust="true"
               command="chown -R sdbadmin:sdbadmin_group ${CI_WORK_DIR}" />
      <scp file="${SDBADMIN_USER}@${firsthost}:${INSTALL_DIR}/bin/sdb"
           password="${SDBADMIN_PWD}"
           trust="true"
           todir="${CI_WORK_DIR}"/>
      <sshexec host="localhost"
               username="${user}"
               password="${passwd}"
               trust="true"
               command="chmod a+x ${CI_WORK_DIR}/sdb" />

      <!--exec deploy.js-->
      <if>
         <equals arg1="${TEST_TYPE}" arg2="NORMALTEST" />
         <then>
            <var name="diagLevel" value="5"/>
         </then>
      </if>
      <if>
         <equals arg1="${TEST_TYPE}" arg2="LARGEDATATEST" />
         <then>
            <var name="diagLevel" value="5"/>
         </then>
      </if>
      <if>
         <equals arg1="${TEST_TYPE}" arg2="SYNCTEST" />
         <then>
            <var name="diagLevel" value="5"/>
         </then>
      </if>
      <if>
         <equals arg1="${TEST_TYPE}" arg2="CONFIGURETEST" />
         <then>
            <var name="diagLevel" value="5"/>
            <var name="DEPLOY_MODE" value="CONFIGURE"/>
         </then>
      </if>
      <if>
         <equals arg1="${TEST_TYPE}" arg2="RELIABILITYTEST" />
         <then>
            <var name="diagLevel" value="5"/>
            <var name="DEPLOY_MODE" value="RELIABILITY"/>
         </then>
      </if>
      <if>
         <equals arg1="${TEST_TYPE}" arg2="SMOKETEST" />
         <then>
            <var name="diagLevel" value="5"/>
         </then>
      </if>
      <if>
         <equals arg1="${TEST_TYPE}" arg2="PERFORMANCETEST_TPCC" />
         <then>
            <var name="diagLevel" value="3"/>
            <var name="DEPLOY_MODE" value="TPCC"/>
         </then>
      </if>
        
      <if>
         <equals arg1="${ISMVCC}" arg2="true" />
         <then>
            <var name="diagLevel" value="5"/>
            <var name="DEPLOY_MODE" value="MVCC"/>
         </then>
      </if>
      <if>
         <and>
             <equals arg1="${TEST_TYPE}" arg2="CONFIGURETEST" />
             <equals arg1="${ISMVCC}" arg2="true" />
         </and>
         <then>
            <var name="diagLevel" value="5"/>
            <var name="DEPLOY_MODE" value="CONFIGURE"/>
         </then>
      </if>
      <property name="sdb_shell" value="${CI_WORK_DIR}/sdb"/>
      <property name="deploy_cmd1" value="-f '${basedir}/src/conf/deploy_conf_${DEPLOY_MODE}.js,${basedir}/src/install_deploy/deploy.js'" />
      <property name="deploy_cmd2" value="-e &quot;var hostList=${testhost_jsarr};var diagLevel=${diagLevel};var METADATA_DIR='${METADATA_DIR}';var INSTALL_DIR='${INSTALL_DIR}';&quot;" />
      <echo message="exec cmd: ${sdb_shell} ${deploy_cmd1} ${deploy_cmd2}"/>

      <hostinfo prefix="host" />
      <if>
         <available file="${CI_WORK_DIR}"/>
         <else>
            <sshexec host="${host.NAME}"
                     username="${user}"
                     password="${passwd}"
                     trust="true"
                     command="mkdir -p ${CI_WORK_DIR};rm -rf ${CI_WORK_DIR}/*;chown -R sdbadmin:sdbadmin_group ${CI_WORK_DIR}" />
         </else>
      </if>
      <sshexec host="${host.NAME}"
               username="${user}"
               password="${passwd}"
               trust="true"
               failonerror="false"
               resultproperty="deploy_status"
               command="${sdb_shell} ${deploy_cmd1} ${deploy_cmd2} > ${CI_WORK_DIR}/deploy_outlog;" />

      <sshexec host="${host.NAME}"
               username="${SDBADMIN_USER}"
               password="${SDBADMIN_PWD}"
               trust="true"
               command="cat ${CI_WORK_DIR}/deploy_outlog" />
      <if>
         <equals arg1="${deploy_status}" arg2="0" />
         <else>
            <fail message="exec: deploy failure ret=${deploy_status}"/>
         </else>
      </if>

   </target>

   <target name="stopnode">
      <property name="SDBADMIN_USER" value="sdbadmin" />
      <property name="SDBADMIN_PWD" value="Admin@1024" />
      <for list="${testhost_list}" param="testhost">
         <sequential>
            <sshexec host="@{testhost}"
                     username="${SDBADMIN_USER}"
                     password="${SDBADMIN_PWD}"
                     trust="true"
                     command="sdbcmtop"
                     failonerror="false"/>
            <sshexec host="@{testhost}"
                     username="${SDBADMIN_USER}"
                     password="${SDBADMIN_PWD}"
                     trust="true"
                     command="sdblist -l"
                     failonerror="false"/>
            <sshexec host="@{testhost}"
                     username="${SDBADMIN_USER}"
                     password="${SDBADMIN_PWD}"
                     trust="true"
                     command="sdbstop -a"
                     failonerror="false"/>
            <sshexec host="@{testhost}"
                     username="${SDBADMIN_USER}"
                     password="${SDBADMIN_PWD}"
                     trust="true"
                     command="sdblist -l"
                     failonerror="false"/>
         </sequential>
      </for>
   </target>

</project>
